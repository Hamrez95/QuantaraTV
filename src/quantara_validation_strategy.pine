//@version=6
strategy("Quantara Vision · Core Validation v0.1.0", overlay = true, initial_capital = 10000, commission_type = strategy.commission.percent, commission_value = 0.10, slippage = 1, pyramiding = 0, process_orders_on_close = true, max_bars_back = 1500)

string G1 = "Validation"
string G2 = "Signal Parity"
string G3 = "Risk / Costs"
string marketType = input.string("Auto", "Market Type", options = ["Auto", "Crypto", "Forex", "Stock", "Index", "Commodity", "Futures", "Generic"], group = G1)
int startTime = input.time(timestamp("2020-01-01T00:00:00Z"), "Start", group = G1)
int endTime = input.time(timestamp("2035-01-01T00:00:00Z"), "End", group = G1)
string sessionInput = input.session("0000-2359:1234567", "Allowed Session", group = G1)
string sessionZone = input.string("Etc/UTC", "Session IANA Zone", group = G1)
bool allowLong = input.bool(true, "Long", group = G1, inline = "side")
bool allowShort = input.bool(true, "Short", group = G1, inline = "side")
int pivotStrength = input.int(5, "Pivot Strength", 2, 20, group = G2)
float minimumScore = input.float(65, "Minimum Score", 0, 100, group = G2)
int emaFastLen = input.int(20, "Fast EMA", 2, 100, group = G2)
int emaSlowLen = input.int(50, "Slow EMA", 5, 300, group = G2)
int volumeLen = input.int(20, "Relative Volume Length", 5, 100, group = G2)
int atrLen = input.int(14, "ATR Length", 5, 100, group = G2)
float riskPct = input.float(1, "Position Risk %", 0.1, 10, 0.1, group = G3)
float stopAtrCap = input.float(3, "Stop Cap · ATR", 0.5, 10, 0.1, group = G3)
float targetRR = input.float(2.5, "Primary Target R:R", 0.5, 10, 0.1, group = G3)
float estimatedExtraCostPct = input.float(0, "Extra Spread/Slippage Cost % (report only)", 0, 10, 0.01, group = G3, tooltip = "Set actual commission/slippage in Strategy Properties. This input adjusts the custom net estimate only.")

float atr = ta.atr(atrLen)
float emaFast = ta.ema(close, emaFastLen)
float emaSlow = ta.ema(close, emaSlowLen)
float ph = ta.pivothigh(high, pivotStrength, pivotStrength)
float pl = ta.pivotlow(low, pivotStrength, pivotStrength)
var float lastHigh = na
var float prevHigh = na
var float lastLow = na
var float prevLow = na
if not na(ph)
    prevHigh := lastHigh
    lastHigh := ph
if not na(pl)
    prevLow := lastLow
    lastLow := pl

bool bullStructure = not na(prevHigh) and not na(prevLow) and lastHigh > prevHigh and lastLow > prevLow
bool bearStructure = not na(prevHigh) and not na(prevLow) and lastHigh < prevHigh and lastLow < prevLow
bool bosUp = not na(lastHigh) and close > lastHigh + atr * 0.12 and close[1] <= lastHigh + atr * 0.12
bool bosDown = not na(lastLow) and close < lastLow - atr * 0.12 and close[1] >= lastLow - atr * 0.12
bool nearSupport = not na(lastLow) and math.abs(close - lastLow) <= atr * 0.65
bool nearResistance = not na(lastHigh) and math.abs(close - lastHigh) <= atr * 0.65
float relVol = ta.sma(volume, volumeLen) > 0 ? volume / ta.sma(volume, volumeLen) : na
bool usableVolume = not na(relVol)
bool bullEngulf = close > open and close >= open[1] and open <= close[1] and close[1] < open[1]
bool bearEngulf = close < open and close <= open[1] and open >= close[1] and close[1] > open[1]
bool bullTrigger = bosUp or bullEngulf and (nearSupport or bullStructure)
bool bearTrigger = bosDown or bearEngulf and (nearResistance or bearStructure)

float longScore = (bullStructure ? 20 : emaFast > emaSlow ? 12 : 2) + (nearSupport ? 15 : close > emaSlow ? 7 : 2) + (emaFast > emaSlow ? 10 : 0) + (bullTrigger ? 15 : 0) + (usableVolume and relVol > 1.2 ? 10 : usableVolume ? 4 : 3) + 15 + 5 + 5 + 5
float shortScore = (bearStructure ? 20 : emaFast < emaSlow ? 12 : 2) + (nearResistance ? 15 : close < emaSlow ? 7 : 2) + (emaFast < emaSlow ? 10 : 0) + (bearTrigger ? 15 : 0) + (usableVolume and relVol > 1.2 ? 10 : usableVolume ? 4 : 3) + 15 + 5 + 5 + 5
bool inDate = time >= startTime and time <= endTime
bool inSession = not na(time(timeframe.period, sessionInput, sessionZone))
bool longSignal = barstate.isconfirmed and inDate and inSession and allowLong and longScore >= minimumScore and longScore > shortScore + 7
bool shortSignal = barstate.isconfirmed and inDate and inSession and allowShort and shortScore >= minimumScore and shortScore > longScore + 7

float longStop = close - math.min(close - nz(lastLow, close - atr * 1.5), atr * stopAtrCap)
float shortStop = close + math.min(nz(lastHigh, close + atr * 1.5) - close, atr * stopAtrCap)
float longDistance = math.max(close - longStop, syminfo.mintick)
float shortDistance = math.max(shortStop - close, syminfo.mintick)
float riskCash = strategy.equity * riskPct / 100
float longQty = riskCash / longDistance
float shortQty = riskCash / shortDistance

if longSignal and strategy.position_size == 0
    strategy.entry("Long", strategy.long, qty = longQty)
    strategy.exit("Long Risk", "Long", stop = longStop, limit = close + longDistance * targetRR)
if shortSignal and strategy.position_size == 0
    strategy.entry("Short", strategy.short, qty = shortQty)
    strategy.exit("Short Risk", "Short", stop = shortStop, limit = close - shortDistance * targetRR)

var int consecutiveLosses = 0
var int maxConsecutiveLosses = 0
var int lastClosedCount = 0
if strategy.closedtrades > lastClosedCount
    float lastProfit = strategy.closedtrades.profit(strategy.closedtrades - 1)
    consecutiveLosses := lastProfit < 0 ? consecutiveLosses + 1 : 0
    maxConsecutiveLosses := math.max(maxConsecutiveLosses, consecutiveLosses)
    lastClosedCount := strategy.closedtrades

float grossProfit = strategy.grossprofit
float grossLoss = math.abs(strategy.grossloss)
float profitFactor = grossLoss > 0 ? grossProfit / grossLoss : na
float averageWin = strategy.wintrades > 0 ? grossProfit / strategy.wintrades : na
float averageLoss = strategy.losstrades > 0 ? grossLoss / strategy.losstrades : na
float winRate = strategy.closedtrades > 0 ? 100 * strategy.wintrades / strategy.closedtrades : na
float expectancy = strategy.closedtrades > 0 ? strategy.netprofit / strategy.closedtrades : na
float extraCosts = strategy.closedtrades * strategy.initial_capital * estimatedExtraCostPct / 100
float adjustedNet = strategy.netprofit - extraCosts

var table report = table.new(position.bottom_right, 2, 10, bgcolor = color.new(#111821, 3), frame_color = #263243, frame_width = 1)
if barstate.islast
    table.cell(report, 0, 0, "QUANTARA VALIDATION", text_color = #A78BFA)
    table.cell(report, 1, 0, "v0.1.0", text_color = #8B98AA)
    table.cell(report, 0, 1, "Trades", text_color = #8B98AA), table.cell(report, 1, 1, str.tostring(strategy.closedtrades), text_color = #E6EDF3)
    table.cell(report, 0, 2, "Win rate", text_color = #8B98AA), table.cell(report, 1, 2, str.tostring(winRate, "#.##") + "%", text_color = #E6EDF3)
    table.cell(report, 0, 3, "Avg win", text_color = #8B98AA), table.cell(report, 1, 3, str.tostring(averageWin, "#.##"), text_color = #2DD4BF)
    table.cell(report, 0, 4, "Avg loss", text_color = #8B98AA), table.cell(report, 1, 4, str.tostring(averageLoss, "#.##"), text_color = #FF6376)
    table.cell(report, 0, 5, "Profit factor", text_color = #8B98AA), table.cell(report, 1, 5, str.tostring(profitFactor, "#.##"), text_color = #E6EDF3)
    table.cell(report, 0, 6, "Expectancy", text_color = #8B98AA), table.cell(report, 1, 6, str.tostring(expectancy, "#.##"), text_color = #E6EDF3)
    table.cell(report, 0, 7, "Max drawdown", text_color = #8B98AA), table.cell(report, 1, 7, str.tostring(strategy.max_drawdown, "#.##"), text_color = #F5B942)
    table.cell(report, 0, 8, "Max loss streak", text_color = #8B98AA), table.cell(report, 1, 8, str.tostring(maxConsecutiveLosses), text_color = #F5B942)
    table.cell(report, 0, 9, "Net after extra cost", text_color = #8B98AA), table.cell(report, 1, 9, str.tostring(adjustedNet, "#.##"), text_color = adjustedNet >= 0 ? #2DD4BF : #FF6376)

plot(emaFast, "Fast EMA", color.new(#5B8CFF, 35))
plot(emaSlow, "Slow EMA", color.new(#64748B, 35))
