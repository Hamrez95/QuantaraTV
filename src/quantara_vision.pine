color C_MUTED   = #8B98AA
color C_BULL    = #2DD4BF
color C_BEAR    = #FF6376
color C_WARN    = #F5B942
color C_INFO    = #5B8CFF
color C_CRYPTO  = #A78BFA
color C_NEUTRAL = #64748B

