bool showGuide = input.bool(true, "Color Guide / راهنمای رنگ", group = G01, tooltip = "سبزآبی = صعود یا هدف، قرمز = نزول یا حد ضرر، زرد = هشدار یا صبر، آبی = ورود یا اطلاعات، بنفش = زمینه بازار.")
