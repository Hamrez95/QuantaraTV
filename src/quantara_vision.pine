//@version=6
indicator("Quantara Vision v0.6.0", "Quantara Vision", overlay = true, max_bars_back = 1500, max_lines_count = 240, max_labels_count = 160, max_boxes_count = 80, dynamic_requests = true)

// Quantara Vision is decision support, not financial advice. Confirmed signals use closed bars.
// External headlines/order flow are intentionally unavailable in Pine; event slots are user supplied.

// ───────────────────────────── Design tokens
color C_CANVAS  = #0B0F14
color C_PANEL   = #111821
color C_SURFACE = #18212D
color C_BORDER  = #263243
color C_TEXT    = #E6EDF3
color C_MUTED   = #8B98AA
color C_BULL    = #2DD4BF
color C_BEAR    = #FF6376
color C_WARN    = #F5B942
color C_INFO    = #5B8CFF
color C_CRYPTO  = #A78BFA
color C_NEUTRAL = #64748B

string G01 = "1 · General"
string G02 = "2 · Market Type"
string G03 = "3 · Trading Style"
string G04 = "4 · Sessions"
string G05 = "5 · Market Structure"
string G06 = "6 · Support / Resistance"
string G07 = "7 · Trendlines"
string G08 = "8 · Price Action"
string G09 = "9 · Volume"
string G10 = "10 · Multi-Timeframe"
string G11 = "11 · Crypto Context"
string G12 = "12 · Forex Context"
string G13 = "13 · Global Indices"
string G14 = "14 · Economic Context"
string G15 = "15 · News / Event Risk"
string G16 = "16 · Risk Management"
string G17 = "17 · Signal Scoring"
string G18 = "18 · Market Radar"
string G19 = "19 · Colors + Visibility"
string G20 = "20 · Alerts"
string G21 = "21 · Performance / Request Budget"
string G22 = "22 · Debug"

string preset = input.string("Balanced", "Preset", options = ["Crypto", "Forex", "Scalping", "Intraday", "Swing", "Aggressive", "Balanced", "Conservative", "Custom"], group = G01, tooltip = "Presets are effective internal configurations. Choose Custom to use every detailed threshold.")
string displayMode = input.string("Compact", "Display Mode", options = ["Full", "Compact", "Minimal", "Radar Focus", "Signal Focus", "Analysis Only"], group = G01)
string panelPos = input.string("Top Right", "Panel Position", options = ["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group = G01)
bool beginnerMode = input.bool(true, "Simple View", group = G01, tooltip = "Recommended for first use. Shows the decision, score, risk, and one concise context row while keeping advanced modules available in Settings.")
bool showGuide = input.bool(true, "Show Panel Help Icon", group = G01, tooltip = "Shows an information symbol in the panel header. Hover over it and other panel fields for short explanations.")
bool showTooltips = input.bool(true, "Enable Hover Help", group = G01, tooltip = "Enables English tooltips when you hover over supported panel cells and Settings information icons.")
string panelTextSize = input.string("Normal", "Panel Text Size", options = ["Small", "Normal", "Large"], group = G01, tooltip = "Changes panel readability without changing signal calculations.")

string marketOverride = input.string("Auto", "Market", options = ["Auto", "Crypto", "Forex", "Stock", "Index", "Commodity", "Futures", "Generic"], group = G02)
string styleInput = input.string("Intraday", "Trading Style", options = ["Scalping", "Intraday", "Swing"], group = G03)
int customPivot = input.int(5, "Custom Pivot Strength", 2, 20, group = G03)
float customMinScore = input.float(65, "Custom Minimum Candidate Score", 0, 100, 1, group = G03)
bool confirmClose = input.bool(true, "Confirm Signals On Bar Close", group = G03)

bool showSessions = input.bool(true, "Use Sessions In Analysis", group = G04, tooltip = "Uses the active trading session in timing and scoring. This switch alone does not add background shading.")
string sessionTemplate = input.string("Market Aware", "Session Template", options = ["Market Aware", "Crypto Liquidity", "Forex Liquidity", "US Cash", "Custom"], group = G04, tooltip = "Market Aware uses Forex liquidity hours for Forex, US cash hours for stocks, and regional-liquidity windows for Crypto/other 24-hour charts. Custom uses the three session fields below exactly as entered.")
string asiaSession = input.session("0000-0800:1234567", "Asia", group = G04)
string londonSession = input.session("0800-1700:1234567", "London", group = G04)
string nySession = input.session("0800-1700:1234567", "New York", group = G04, tooltip = "Custom New York window interpreted in the selected New York IANA zone. Forex-liquidity default is 08:00–17:00 ET; US Cash is 09:30–16:00 ET.")
string asiaZone = input.string("Asia/Singapore", "Asia IANA Time Zone", group = G04)
string londonZone = input.string("Europe/London", "London IANA Time Zone", group = G04)
string nyZone = input.string("America/New_York", "New York IANA Time Zone", group = G04)
bool showPrevSession = input.bool(false, "Previous Session High / Low", group = G04, tooltip = "Draws completed Asia, London, and New York session ranges. Leave it off unless session-range levels are part of your plan.")
bool showAsiaBg = input.bool(false, "Shade Asia", group = G04, inline = "session-bg", tooltip = "Very faint purple background = Asia session.")
bool showLondonBg = input.bool(false, "London", group = G04, inline = "session-bg", tooltip = "Very faint blue background = London session.")
bool showNyBg = input.bool(false, "New York", group = G04, inline = "session-bg", tooltip = "Very faint amber background = New York session.")
bool showOverlapBg = input.bool(false, "Overlap", group = G04, inline = "session-bg2", tooltip = "Highlights the London/New York overlap separately.")
bool showMarketStatus = input.bool(true, "Show Exchange / Session Status", group = G04, tooltip = "Shows the active regional session and, where Pine exposes it, whether the current chart bar is inside the exchange's regular market session. Exchange holidays create no bars, so future holiday calendars cannot be detected automatically.")

bool showStructure = input.bool(true, "Show Confirmed Structure", group = G05, tooltip = "HH = higher high, HL = higher low, LH = lower high, LL = lower low, BOS = break of structure, CHoCH = possible structure change.")
int maxStructureLabels = input.int(10, "Maximum Recent Labels", 4, 60, group = G05, tooltip = "Keeps only this many recent structure labels to prevent chart clutter.")
float breakoutAtr = input.float(0.12, "Breakout Confirmation · ATR", 0, 1, 0.01, group = G05)
int structureExpiry = input.int(120, "Setup Expiry Bars", 10, 500, group = G05)

bool showLevels = input.bool(true, "Show Levels", group = G06, tooltip = "Teal = support; coral = resistance. Dashed = tested more than once; dotted and faded = broken.")
int maxLevels = input.int(5, "Maximum Visible Levels", 2, 16, group = G06)
float clusterAtr = input.float(0.35, "Clustering Distance · ATR", 0.05, 2, 0.05, group = G06)
int levelLookback = input.int(300, "Level Lookback", 50, 1000, group = G06)

bool showTrendlines = input.bool(false, "Enable Pivot Trendlines", group = G07, tooltip = "Connects confirmed higher lows or lower highs only. Disabled by default for a cleaner first view.")
bool trendOn5m = input.bool(true, "5m", group = G07, inline = "trend-tf1", tooltip = "Show the chart-timeframe trendline when the chart is 5 minutes.")
bool trendOn15m = input.bool(true, "15m", group = G07, inline = "trend-tf1", tooltip = "Show the chart-timeframe trendline when the chart is 15 minutes.")
bool trendOn1h = input.bool(true, "1h", group = G07, inline = "trend-tf1", tooltip = "Show the chart-timeframe trendline when the chart is 1 hour.")
bool trendOn4h = input.bool(true, "4h", group = G07, inline = "trend-tf2", tooltip = "Show the chart-timeframe trendline when the chart is 4 hours.")
bool trendOn1d = input.bool(true, "1D", group = G07, inline = "trend-tf2", tooltip = "Show the chart-timeframe trendline when the chart is 1 day.")
bool trendOnOther = input.bool(false, "Other TF", group = G07, inline = "trend-tf2", tooltip = "Show the chart-timeframe trendline on all other timeframes.")
int trendProjectionBars = input.int(60, "Projection Bars", 5, 250, group = G07, tooltip = "Limits how far a confirmed trendline projects after its second pivot.")
bool showChannel = input.bool(false, "Parallel Channel Approximation", group = G07, tooltip = "Optional approximate parallel channel. Leave off when you want only the validated trendline.")
bool showHtfTrendlines = input.bool(false, "Enable Higher-TF Trendlines / Channels", group = G07, tooltip = "Projects confirmed trendlines from selected higher timeframes onto the current chart. Example: enable TF 4 (4H) while viewing a 1H chart.")
bool showHtfChannel = input.bool(true, "Draw Parallel Higher-TF Channel", group = G07, tooltip = "Draws the opposite parallel boundary when both sides have confirmed pivots. Solid edge = validated pivot trendline; dashed edge = parallel channel approximation.")
bool showHtf1 = input.bool(false, "TF 1", group = G07, inline = "htf-vis1", tooltip = "Uses TF 1 from Multi-Timeframe settings. It is drawn only when it is higher than the chart timeframe.")
bool showHtf2 = input.bool(false, "TF 2", group = G07, inline = "htf-vis1", tooltip = "Uses TF 2 from Multi-Timeframe settings. It is drawn only when it is higher than the chart timeframe.")
bool showHtf3 = input.bool(false, "TF 3", group = G07, inline = "htf-vis1", tooltip = "Uses TF 3 from Multi-Timeframe settings. It is drawn only when it is higher than the chart timeframe.")
bool showHtf4 = input.bool(true, "TF 4", group = G07, inline = "htf-vis2", tooltip = "Default TF 4 is 4H. Enable the higher-TF master switch to inspect this channel on lower-timeframe charts.")
bool showHtf5 = input.bool(false, "TF 5", group = G07, inline = "htf-vis2", tooltip = "Default TF 5 is 1D. It is drawn only on chart timeframes below 1D.")
bool showHtfLabels = input.bool(true, "Higher-TF Channel Labels", group = G07, tooltip = "Labels each projected channel with its source timeframe and direction.")
