//@version=6
indicator("Quantara Vision v0.2.0", "Quantara Vision", overlay = true, max_bars_back = 1500, max_lines_count = 240, max_labels_count = 160, max_boxes_count = 80, dynamic_requests = true)

// Quantara Vision is decision support, not financial advice. Confirmed signals use closed bars.
// External headlines/order flow are intentionally unavailable in Pine; event slots are user supplied.

// ───────────────────────────── Design tokens
color C_CANVAS  = #0B0F14
color C_PANEL   = #111821
color C_SURFACE = #18212D
color C_BORDER  = #263243
