f_pos(string p) => p == "Top Left" ? position.top_left : p == "Bottom Right" ? position.bottom_right : p == "Bottom Left" ? position.bottom_left : position.top_right
f_clamp(float value, float lo, float hi) => math.max(lo, math.min(hi, value))
f_fmt(float value) => na(value) ? "—" : str.tostring(value, format.mintick)
f_json_num(float value) => na(value) ? "null" : str.tostring(value, format.mintick)
f_dir_text(int direction) => direction > 0 ? "▲ BULL" : direction < 0 ? "▼ BEAR" : "◆ RANGE"
f_dir_color(int direction) => direction > 0 ? C_BULL : direction < 0 ? C_BEAR : C_WARN
f_tf_state(float fast, float slow, float rsi) => fast > slow and rsi > 52 ? 1 : fast < slow and rsi < 48 ? -1 : 0
f_tf_mark(int state) => state == 2 ? "…" : state > 0 ? "▲" : state < 0 ? "▼" : "◆"
f_tf_color(int state) => state == 2 ? C_MUTED : f_dir_color(state)
f_tf_name(string tf) => tf == "5" ? "5m" : tf == "15" ? "15m" : tf == "60" ? "1H" : tf == "240" ? "4H" : tf == "1D" or tf == "D" ? "1D" : tf
f_currency_strength(string c, float usd, float eur, float gbp, float jpy, float aud, float cad, float chf) => c == "USD" ? usd : c == "EUR" ? eur : c == "GBP" ? gbp : c == "JPY" ? jpy : c == "AUD" ? aud : c == "CAD" ? cad : c == "CHF" ? chf : 0.0
f_econ_country(string currency) => currency == "USD" ? "US" : currency == "EUR" ? "EU" : currency == "GBP" ? "GB" : currency == "JPY" ? "JP" : currency == "AUD" ? "AU" : currency == "CAD" ? "CA" : currency == "CHF" ? "CH" : currency == "NZD" ? "NZ" : "US"
f_market_matches(string affected) => affected == "" or str.contains(str.upper(affected), str.upper(syminfo.basecurrency)) or str.contains(str.upper(affected), str.upper(syminfo.currency)) or str.contains(str.upper(affected), str.upper(syminfo.ticker))
f_in_event(int eventTime) => eventTime > 0 and time_close >= eventTime - eventWarnMinutes * 60000 and time <= eventTime + eventCooldownMinutes * 60000
f_pre_event(int eventTime) => eventTime > 0 and timenow < eventTime and timenow >= eventTime - eventWarnMinutes * 60000
f_post_event(int eventTime) => eventTime > 0 and timenow >= eventTime and timenow <= eventTime + eventCooldownMinutes * 60000
f_context_tuple() => [close, close[contextRocLen] == 0 ? 0.0 : 100 * (close / close[contextRocLen] - 1), ta.ema(close, 20), ta.atr(14)]
f_radar_tuple() => [close, ta.ema(close, 20), ta.ema(close, 50), ta.rsi(close, 14), volume, ta.sma(volume, 20), ta.atr(14)]

type MtfData
    float fast
    float slow
    float rsi
    float oldLow
    int oldLowTime
    float newLow
    int newLowTime
    float oldHigh
    int oldHighTime
    float newHigh
    int newHighTime

f_mtf_data(int strength) =>
    float pivotHigh = ta.pivothigh(high, strength, strength)
    float pivotLow = ta.pivotlow(low, strength, strength)
    MtfData.new(ta.ema(close, 20)[1], ta.ema(close, 50)[1], ta.rsi(close, 14)[1], ta.valuewhen(not na(pivotLow), pivotLow, 1)[1], ta.valuewhen(not na(pivotLow), time[strength], 1)[1], ta.valuewhen(not na(pivotLow), pivotLow, 0)[1], ta.valuewhen(not na(pivotLow), time[strength], 0)[1], ta.valuewhen(not na(pivotHigh), pivotHigh, 1)[1], ta.valuewhen(not na(pivotHigh), time[strength], 1)[1], ta.valuewhen(not na(pivotHigh), pivotHigh, 0)[1], ta.valuewhen(not na(pivotHigh), time[strength], 0)[1])

f_clear_mtf(array<line> lines, array<label> labels) =>
    if array.size(lines) > 0
        for i = 0 to array.size(lines) - 1
            line.delete(array.get(lines, i))
        array.clear(lines)
    if array.size(labels) > 0
        for i = 0 to array.size(labels) - 1
            label.delete(array.get(labels, i))
        array.clear(labels)

f_draw_mtf_channel(array<line> lines, array<label> labels, bool enabled, string tfName, int tfMillis, float oldLow, int oldLowTime, float newLow, int newLowTime, float oldHigh, int oldHighTime, float newHigh, int newHighTime) =>
    if enabled and tfMillis > 0
        bool ascending = not na(oldLow) and not na(newLow) and not na(oldLowTime) and not na(newLowTime) and newLowTime > oldLowTime and newLow > oldLow and (na(oldHigh) or na(newHigh) or newHigh > oldHigh)
        bool descending = not na(oldHigh) and not na(newHigh) and not na(oldHighTime) and not na(newHighTime) and newHighTime > oldHighTime and newHigh < oldHigh and (na(oldLow) or na(newLow) or newLow < oldLow)
        if ascending
            int projectedTime = newLowTime + tfMillis * trendProjectionBars
            float slope = (newLow - oldLow) / math.max(1, newLowTime - oldLowTime)
            float projectedLow = newLow + slope * (projectedTime - newLowTime)
            line mainLine = line.new(x1 = oldLowTime, y1 = oldLow, x2 = projectedTime, y2 = projectedLow, xloc = xloc.bar_time, extend = extend.none, color = color.new(C_BULL, 8), width = 2)
            array.push(lines, mainLine)
            if showHtfChannel and not na(oldHigh) and not na(newHigh) and newHigh > oldHigh and not na(newHighTime)
                float lowerAtHigh = oldLow + slope * (newHighTime - oldLowTime)
                float channelOffset = newHigh - lowerAtHigh
                line parallelLine = line.new(x1 = oldLowTime, y1 = oldLow + channelOffset, x2 = projectedTime, y2 = projectedLow + channelOffset, xloc = xloc.bar_time, extend = extend.none, color = color.new(C_BULL, 45), width = 1, style = line.style_dashed)
                array.push(lines, parallelLine)
            if showHtfLabels
                label tag = label.new(x = projectedTime, y = projectedLow, text = tfName + " ASC CHANNEL", xloc = xloc.bar_time, style = label.style_label_left, color = color.new(C_PANEL, 15), textcolor = C_BULL, size = size.tiny, tooltip = "Confirmed " + tfName + " rising support trendline. Dashed boundary is a parallel channel approximation.")
                array.push(labels, tag)
        else if descending
            int projectedTime = newHighTime + tfMillis * trendProjectionBars
            float slope = (newHigh - oldHigh) / math.max(1, newHighTime - oldHighTime)
            float projectedHigh = newHigh + slope * (projectedTime - newHighTime)
            line mainLine = line.new(x1 = oldHighTime, y1 = oldHigh, x2 = projectedTime, y2 = projectedHigh, xloc = xloc.bar_time, extend = extend.none, color = color.new(C_BEAR, 8), width = 2)
            array.push(lines, mainLine)
            if showHtfChannel and not na(oldLow) and not na(newLow) and newLow < oldLow and not na(newLowTime)
                float upperAtLow = oldHigh + slope * (newLowTime - oldHighTime)
                float channelOffset = newLow - upperAtLow
                line parallelLine = line.new(x1 = oldHighTime, y1 = oldHigh + channelOffset, x2 = projectedTime, y2 = projectedHigh + channelOffset, xloc = xloc.bar_time, extend = extend.none, color = color.new(C_BEAR, 45), width = 1, style = line.style_dashed)
                array.push(lines, parallelLine)
            if showHtfLabels
                label tag = label.new(x = projectedTime, y = projectedHigh, text = tfName + " DESC CHANNEL", xloc = xloc.bar_time, style = label.style_label_left, color = color.new(C_PANEL, 15), textcolor = C_BEAR, size = size.tiny, tooltip = "Confirmed " + tfName + " falling resistance trendline. Dashed boundary is a parallel channel approximation.")
                array.push(labels, tag)

int pivotEff = preset == "Scalping" ? 3 : preset == "Swing" ? 8 : preset == "Aggressive" ? 3 : preset == "Conservative" ? 8 : preset == "Custom" ? customPivot : 5
float minScoreEff = preset == "Aggressive" ? 55 : preset == "Conservative" ? 75 : preset == "Scalping" ? 60 : preset == "Swing" ? 70 : preset == "Custom" ? customMinScore : 65
string styleEff = preset == "Scalping" ? "Scalping" : preset == "Swing" ? "Swing" : styleInput
string detectedMarket = syminfo.type == "crypto" ? "Crypto" : syminfo.type == "forex" ? "Forex" : syminfo.type == "stock" ? "Stock" : syminfo.type == "index" ? "Index" : syminfo.type == "futures" ? "Futures" : "Generic"
string marketType = marketOverride == "Auto" ? detectedMarket : marketOverride
bool isCrypto = marketType == "Crypto"
bool isForex = marketType == "Forex"
bool isStock = marketType == "Stock"
// Session strings are interpreted in their own IANA zones. This prevents a New York
// time such as 08:00 from being accidentally treated as 08:00 London time.
bool useForexTemplate = sessionTemplate == "Forex Liquidity" or sessionTemplate == "Market Aware" and isForex
bool useCashTemplate = sessionTemplate == "US Cash" or sessionTemplate == "Market Aware" and isStock
bool useCryptoTemplate = sessionTemplate == "Crypto Liquidity" or sessionTemplate == "Market Aware" and not isForex and not isStock
string asiaSessionEff = sessionTemplate == "Custom" ? asiaSession : "0000-0800:1234567"
string londonSessionEff = sessionTemplate == "Custom" ? londonSession : "0800-1700:1234567"
string nySessionEff = sessionTemplate == "Custom" ? nySession : useCashTemplate ? "0930-1600:1234567" : useForexTemplate ? "0800-1700:1234567" : useCryptoTemplate ? "0800-1700:1234567" : nySession
bool signalsAllowed = displayMode != "Analysis Only"
bool compactMode = displayMode == "Compact" or displayMode == "Minimal"
bool showSignalPanel = displayMode != "Minimal" and displayMode != "Radar Focus" and displayMode != "Analysis Only"
bool showRadarEff = enableRadar and not (beginnerMode and displayMode == "Compact") and displayMode != "Minimal" and displayMode != "Signal Focus" and displayMode != "Analysis Only" and resourceProfile != "Chart Focus" and resourceProfile != "Macro Focus"
int radarLimit = resourceProfile == "Radar Focus" ? 10 : 6
bool fullMacro = resourceProfile == "Macro Focus"
bool balancedContext = resourceProfile == "Balanced"
string panelSizeEff = panelTextSize == "Large" ? size.large : panelTextSize == "Small" ? size.small : size.normal

float chartSeconds = timeframe.in_seconds()
bool trendTfEnabled = chartSeconds == timeframe.in_seconds("5") ? trendOn5m : chartSeconds == timeframe.in_seconds("15") ? trendOn15m : chartSeconds == timeframe.in_seconds("60") ? trendOn1h : chartSeconds == timeframe.in_seconds("240") ? trendOn4h : chartSeconds == timeframe.in_seconds("1D") ? trendOn1d : trendOnOther
bool showTrendlinesEff = showTrendlines and trendTfEnabled and displayMode != "Radar Focus"

float atr = ta.atr(atrLen)
float atrPct = close != 0 ? atr / close * 100 : na
float atrPctBase = ta.sma(atrPct, 100)
bool volExpansion = atrPct > atrPctBase * 1.25
bool volCompression = atrPct < atrPctBase * 0.72
bool excessiveVol = atrPct > atrPctBase * 2.0
float emaFast = ta.ema(close, emaFastLen)
float emaSlow = ta.ema(close, emaSlowLen)
float vwapValue = ta.vwap(hlc3)
bool volumeAvailable = not na(volume) and ta.sma(volume, volumeLen) > 0
float relativeVolume = volumeAvailable ? volume / ta.sma(volume, volumeLen) : na
bool abnormalVol = volumeAvailable and relativeVolume >= abnormalVolume
bool lowVolume = volumeAvailable and relativeVolume < 0.65
string volumeQuality = not volumeAvailable ? "Unavailable" : isForex ? "Tick volume · proxy" : "Exchange/feed volume"

float ph = ta.pivothigh(high, pivotEff, pivotEff)
float pl = ta.pivotlow(low, pivotEff, pivotEff)
var float lastHigh = na
var float prevHigh = na
var float lastLow = na
var float prevLow = na
var int lastHighBar = na
var int prevHighBar = na
var int lastLowBar = na
var int prevLowBar = na
var array<label> structureLabels = array.new<label>()
var array<float> srPrices = array.new<float>()
var array<int> srTouches = array.new<int>()
var array<bool> srIsSupport = array.new<bool>()
var array<line> srLines = array.new<line>()
var array<int> srBrokenBar = array.new<int>()

f_add_structure(int x, float y, string txt, color clr, bool above) =>
    if showStructure and displayMode != "Radar Focus"
        label lb = label.new(x, y, txt, xloc = xloc.bar_index, style = above ? label.style_label_down : label.style_label_up, color = color.new(C_CANVAS, 100), textcolor = clr, size = size.tiny)
        array.push(structureLabels, lb)
        if array.size(structureLabels) > maxStructureLabels
            label.delete(array.shift(structureLabels))

f_add_level(float price, bool support, int originBar) =>
    bool merged = false
    if array.size(srPrices) > 0
        for i = 0 to array.size(srPrices) - 1
            if math.abs(array.get(srPrices, i) - price) <= atr * clusterAtr
                float combined = (array.get(srPrices, i) * array.get(srTouches, i) + price) / (array.get(srTouches, i) + 1)
                array.set(srPrices, i, combined)
                array.set(srTouches, i, array.get(srTouches, i) + 1)
                merged := true
                break
    if not merged
        array.push(srPrices, price)
        array.push(srTouches, 1)
        array.push(srIsSupport, support)
        line ln = line.new(math.max(originBar, bar_index - levelLookback), price, bar_index + 1, price, extend = extend.right, color = color.new(support ? C_BULL : C_BEAR, 38), width = 1)
        array.push(srLines, ln)
        array.push(srBrokenBar, na)
        if array.size(srPrices) > maxLevels
            array.shift(srPrices)
            array.shift(srTouches)
            array.shift(srIsSupport)
            array.shift(srBrokenBar)
            line.delete(array.shift(srLines))

f_nearest_level(bool wantSupport) =>
    float best = na
    if array.size(srPrices) > 0
        for i = 0 to array.size(srPrices) - 1
            float candidate = array.get(srPrices, i)
            bool roleMatches = array.get(srIsSupport, i) == wantSupport
            bool priceSideMatches = wantSupport ? candidate <= close : candidate >= close
            if roleMatches and priceSideMatches and (na(best) or math.abs(close - candidate) < math.abs(close - best))
                best := candidate
    best

f_level_touch_count(float level) =>
    int count = 0
    if not na(level) and array.size(srPrices) > 0
        for i = 0 to array.size(srPrices) - 1
            if array.get(srPrices, i) == level
                count := array.get(srTouches, i)
    count

if not na(ph)
    prevHigh := lastHigh
    prevHighBar := lastHighBar
    lastHigh := ph
    lastHighBar := bar_index - pivotEff
    f_add_structure(lastHighBar, ph, na(prevHigh) ? "SH" : ph > prevHigh ? "HH" : "LH", ph > nz(prevHigh, ph) ? C_BULL : C_BEAR, true)
    if showLevels
        f_add_level(ph, false, lastHighBar)
if not na(pl)
    prevLow := lastLow
    prevLowBar := lastLowBar
    lastLow := pl
    lastLowBar := bar_index - pivotEff
    f_add_structure(lastLowBar, pl, na(prevLow) ? "SL" : pl > prevLow ? "HL" : "LL", pl > nz(prevLow, pl) ? C_BULL : C_BEAR, false)
    if showLevels
        f_add_level(pl, true, lastLowBar)

if showLevels and array.size(srPrices) > 0
    for i = 0 to array.size(srPrices) - 1
        float lp = array.get(srPrices, i)
        int touches = array.get(srTouches, i)
        bool wasSupport = array.get(srIsSupport, i)
        bool brokeNow = wasSupport ? close < lp - atr * breakoutAtr and close[1] >= lp - atr * breakoutAtr : close > lp + atr * breakoutAtr and close[1] <= lp + atr * breakoutAtr
        if brokeNow
            array.set(srIsSupport, i, not wasSupport)
            array.set(srBrokenBar, i, bar_index)
        int brokenAt = array.get(srBrokenBar, i)
        bool recentlyBroken = not na(brokenAt) and bar_index - brokenAt <= 15
        line ln = array.get(srLines, i)
        line.set_y1(ln, lp)
        line.set_y2(ln, lp)
        line.set_x2(ln, bar_index + 1)
        line.set_style(ln, recentlyBroken ? line.style_dotted : touches >= 2 ? line.style_dashed : line.style_solid)
        line.set_width(ln, touches >= 3 ? 2 : 1)
        line.set_color(ln, color.new(array.get(srIsSupport, i) ? C_BULL : C_BEAR, recentlyBroken ? 65 : touches >= 2 ? 45 : 25))

bool bullStructure = not na(lastHigh) and not na(prevHigh) and not na(lastLow) and not na(prevLow) and lastHigh > prevHigh and lastLow > prevLow
bool bearStructure = not na(lastHigh) and not na(prevHigh) and not na(lastLow) and not na(prevLow) and lastHigh < prevHigh and lastLow < prevLow
bool bosUp = not na(lastHigh) and close > lastHigh + atr * breakoutAtr and close[1] <= lastHigh + atr * breakoutAtr
bool bosDown = not na(lastLow) and close < lastLow - atr * breakoutAtr and close[1] >= lastLow - atr * breakoutAtr
bool chochUp = bearStructure[1] and bosUp
bool chochDown = bullStructure[1] and bosDown
bool sweepHigh = not na(lastHigh) and high > lastHigh and close < lastHigh
bool sweepLow = not na(lastLow) and low < lastLow and close > lastLow
bool failedBreakUp = high > nz(lastHigh, high) and close < nz(lastHigh, close)
bool failedBreakDown = low < nz(lastLow, low) and close > nz(lastLow, close)
bool retestUp = ta.barssince(bosUp) > 0 and ta.barssince(bosUp) <= 12 and low <= nz(lastHigh, low) + atr * 0.2 and close > nz(lastHigh, close)
bool retestDown = ta.barssince(bosDown) > 0 and ta.barssince(bosDown) <= 12 and high >= nz(lastLow, high) - atr * 0.2 and close < nz(lastLow, close)
int structureDir = bullStructure ? 1 : bearStructure ? -1 : emaFast > emaSlow and math.abs(emaFast - emaSlow) > atr * 0.25 ? 1 : emaFast < emaSlow and math.abs(emaFast - emaSlow) > atr * 0.25 ? -1 : 0

if (bosUp or bosDown or chochUp or chochDown) and showStructure
    f_add_structure(bar_index, bosUp or chochUp ? low : high, chochUp or chochDown ? "CHoCH" : "BOS", chochUp or chochDown ? C_CRYPTO : C_INFO, not (bosUp or chochUp))
var int lastSweepLabelBar = na
bool sweepLabelAllowed = na(lastSweepLabelBar) or bar_index - lastSweepLabelBar >= math.max(pivotEff, 5)
if (sweepHigh or sweepLow) and showStructure and sweepLabelAllowed
    f_add_structure(bar_index, sweepHigh ? high : low, "LIQ SWEEP", C_WARN, sweepHigh)
    lastSweepLabelBar := bar_index

var line upTrend = na
var line downTrend = na
var line channelLine = na
if showTrendlinesEff and not na(pl) and not na(prevLowBar) and lastLowBar > prevLowBar
    line.delete(upTrend)
    upTrend := na
    if lastLow > prevLow
        float upSlope = (lastLow - prevLow) / (lastLowBar - prevLowBar)
        upTrend := line.new(prevLowBar, prevLow, lastLowBar + trendProjectionBars, lastLow + upSlope * trendProjectionBars, extend = extend.none, color = color.new(C_BULL, 20), width = 2)
    if showChannel and not na(prevHigh)
        line.delete(channelLine)
        channelLine := na
        if lastLow > prevLow
            float channelSlope = (lastLow - prevLow) / (lastLowBar - prevLowBar)
            channelLine := line.new(prevLowBar, prevHigh, lastLowBar + trendProjectionBars, prevHigh + channelSlope * (lastLowBar + trendProjectionBars - prevLowBar), extend = extend.none, color = color.new(C_BULL, 60), style = line.style_dashed)
if showTrendlinesEff and not na(ph) and not na(prevHighBar) and lastHighBar > prevHighBar
    line.delete(downTrend)
    downTrend := na
    if lastHigh < prevHigh
        float downSlope = (lastHigh - prevHigh) / (lastHighBar - prevHighBar)
        downTrend := line.new(prevHighBar, prevHigh, lastHighBar + trendProjectionBars, lastHigh + downSlope * trendProjectionBars, extend = extend.none, color = color.new(C_BEAR, 20), width = 2)
    if showChannel and not na(prevLow)
        line.delete(channelLine)
        channelLine := na
        if lastHigh < prevHigh
            float channelSlope = (lastHigh - prevHigh) / (lastHighBar - prevHighBar)
            channelLine := line.new(prevHighBar, prevLow, lastHighBar + trendProjectionBars, prevLow + channelSlope * (lastHighBar + trendProjectionBars - prevHighBar), extend = extend.none, color = color.new(C_BEAR, 60), style = line.style_dashed)
float upTrendNow = not na(upTrend) and bar_index <= line.get_x2(upTrend) ? line.get_price(upTrend, bar_index) : na
float downTrendNow = not na(downTrend) and bar_index <= line.get_x2(downTrend) ? line.get_price(downTrend, bar_index) : na
bool trendBreakDown = not na(upTrendNow) and close < upTrendNow and close[1] >= nz(upTrendNow[1], upTrendNow)
bool trendBreakUp = not na(downTrendNow) and close > downTrendNow and close[1] <= nz(downTrendNow[1], downTrendNow)

bool asiaActive = not na(time(timeframe.period, asiaSessionEff, asiaZone))
bool londonActive = not na(time(timeframe.period, londonSessionEff, londonZone))
bool nyActive = not na(time(timeframe.period, nySessionEff, nyZone))
bool overlapActive = londonActive and nyActive
string activeSession = overlapActive ? "LON/NY" : nyActive ? "New York" : londonActive ? "London" : asiaActive ? "Asia" : "Transition"
var float asiaHigh = na
var float asiaLow = na
var float prevAsiaHigh = na
var float prevAsiaLow = na
bool asiaStart = asiaActive and not asiaActive[1]
bool asiaEnd = not asiaActive and asiaActive[1]
if asiaStart
    asiaHigh := high
    asiaLow := low
if asiaActive
    asiaHigh := math.max(nz(asiaHigh, high), high)
    asiaLow := math.min(nz(asiaLow, low), low)
if asiaEnd
    prevAsiaHigh := asiaHigh
    prevAsiaLow := asiaLow
var float londonHigh = na
var float londonLow = na
var float prevLondonHigh = na
var float prevLondonLow = na
bool londonStart = londonActive and not londonActive[1]
bool londonEnd = not londonActive and londonActive[1]
if londonStart
    londonHigh := high
    londonLow := low
if londonActive
    londonHigh := math.max(nz(londonHigh, high), high)
    londonLow := math.min(nz(londonLow, low), low)
if londonEnd
    prevLondonHigh := londonHigh
    prevLondonLow := londonLow
var float nyHigh = na
var float nyLow = na
var float prevNyHigh = na
var float prevNyLow = na
bool nyStart = nyActive and not nyActive[1]
bool nyEnd = not nyActive and nyActive[1]
if nyStart
    nyHigh := high
    nyLow := low
if nyActive
    nyHigh := math.max(nz(nyHigh, high), high)
    nyLow := math.min(nz(nyLow, low), low)
if nyEnd
    prevNyHigh := nyHigh
    prevNyLow := nyLow
bool londonAsiaBreakUp = londonActive and not na(prevAsiaHigh) and close > prevAsiaHigh and close[1] <= prevAsiaHigh
bool londonAsiaBreakDown = londonActive and not na(prevAsiaLow) and close < prevAsiaLow and close[1] >= prevAsiaLow
bool nyLondonBreakUp = nyActive and not na(prevLondonHigh) and close > prevLondonHigh and close[1] <= prevLondonHigh
bool nyLondonBreakDown = nyActive and not na(prevLondonLow) and close < prevLondonLow and close[1] >= prevLondonLow
bool lowLiquidity = not asiaActive and not londonActive and not nyActive
string marketStatus = isCrypto ? "24/7 · " + activeSession : isForex ? (lowLiquidity ? "24x5 · LOW LIQUIDITY" : "24x5 · " + activeSession) : session.ismarket ? "REGULAR OPEN" : "OUTSIDE REGULAR"
string marketStatusTip = "London/Europe and New York use IANA time zones, so daylight-saving changes are handled by TradingView. For exchange-traded symbols, REGULAR OPEN follows the chart symbol's exchange session. Pine has no general future holiday-calendar feed; on a holiday no new chart bars exist. Use Manual Event Slots for known closures or exceptional events."
color sessionShade = overlapActive and showOverlapBg ? color.new(C_CRYPTO, 94) : londonActive and showLondonBg ? color.new(C_INFO, 96) : nyActive and showNyBg ? color.new(C_WARN, 97) : asiaActive and showAsiaBg ? color.new(C_CRYPTO, 97) : na
bgcolor(showSessions and showSessionBg ? sessionShade : na, title = "Session shading")
plot(showPrevSession ? prevAsiaHigh : na, "Previous Asia High", color.new(C_CRYPTO, 55), 1, plot.style_linebr, display = display.pane)
plot(showPrevSession ? prevAsiaLow : na, "Previous Asia Low", color.new(C_CRYPTO, 55), 1, plot.style_linebr, display = display.pane)
plot(showPrevSession ? prevLondonHigh : na, "Previous London High", color.new(C_INFO, 62), 1, plot.style_linebr, display = display.pane)
plot(showPrevSession ? prevLondonLow : na, "Previous London Low", color.new(C_INFO, 62), 1, plot.style_linebr, display = display.pane)
plot(showPrevSession ? prevNyHigh : na, "Previous New York High", color.new(C_WARN, 62), 1, plot.style_linebr, display = display.pane)
plot(showPrevSession ? prevNyLow : na, "Previous New York Low", color.new(C_WARN, 62), 1, plot.style_linebr, display = display.pane)

float body = math.max(math.abs(close - open), syminfo.mintick)
float upperWick = high - math.max(open, close)
float lowerWick = math.min(open, close) - low
float candleRange = math.max(high - low, syminfo.mintick)
bool bullEngulf = close > open and close >= open[1] and open <= close[1] and close[1] < open[1] and close[1] < emaFast[1]
bool bearEngulf = close < open and close <= open[1] and open >= close[1] and close[1] > open[1] and close[1] > emaFast[1]
bool bullReject = lowerWick >= body * rejectionWick and close > open
bool bearReject = upperWick >= body * rejectionWick and close < open
bool insideBar = high < high[1] and low > low[1]
bool expansionCandle = high - low > atr * 1.4
float nearestSupport = f_nearest_level(true)
float nearestResistance = f_nearest_level(false)
int nearestSupportTouches = f_level_touch_count(nearestSupport)
int nearestResistanceTouches = f_level_touch_count(nearestResistance)
bool nearSupport = not na(nearestSupport) and math.abs(close - nearestSupport) <= atr * 0.65
bool nearResistance = not na(nearestResistance) and math.abs(close - nearestResistance) <= atr * 0.65
bool smallMiddleCandle = body[1] <= math.max(high[1] - low[1], syminfo.mintick) * 0.35
bool morningStar = enableMultiCandlePatterns and close[2] < open[2] and body[2] >= atr[2] * 0.35 and smallMiddleCandle and close > open and close >= (open[2] + close[2]) * 0.5
bool eveningStar = enableMultiCandlePatterns and close[2] > open[2] and body[2] >= atr[2] * 0.35 and smallMiddleCandle and close < open and close <= (open[2] + close[2]) * 0.5
bool threeSoldiers = enableMultiCandlePatterns and close > open and close[1] > open[1] and close[2] > open[2] and close > close[1] and close[1] > close[2] and body >= atr * 0.25 and body[1] >= atr[1] * 0.25 and body[2] >= atr[2] * 0.25
bool threeCrows = enableMultiCandlePatterns and close < open and close[1] < open[1] and close[2] < open[2] and close < close[1] and close[1] < close[2] and body >= atr * 0.25 and body[1] >= atr[1] * 0.25 and body[2] >= atr[2] * 0.25
bool insideBreakUp = insideBar[1] and expansionCandle and close > high[1]
bool insideBreakDown = insideBar[1] and expansionCandle and close < low[1]
bool indecisionPattern = body <= candleRange * 0.1 and (nearSupport or nearResistance or sweepHigh or sweepLow)
bool bullCandleRaw = bullEngulf or bullReject or morningStar or threeSoldiers or insideBreakUp
bool bearCandleRaw = bearEngulf or bearReject or eveningStar or threeCrows or insideBreakDown
// Reversal patterns require location. A live London/New York session alone is not location.
bool bullCandleAligned = bullCandleRaw and (nearSupport or sweepLow or retestUp)
bool bearCandleAligned = bearCandleRaw and (nearResistance or sweepHigh or retestDown)
string bullPatternName = morningStar ? "Morning Star" : threeSoldiers ? "Three Soldiers" : bullEngulf ? "Bullish Engulfing" : bullReject ? "Hammer / Rejection" : insideBreakUp ? "Inside-Bar Breakout" : "Bullish Candle"
string bearPatternName = eveningStar ? "Evening Star" : threeCrows ? "Three Crows" : bearEngulf ? "Bearish Engulfing" : bearReject ? "Shooting Star / Rejection" : insideBreakDown ? "Inside-Bar Breakdown" : "Bearish Candle"
bool bullTrigger = enablePatterns and (retestUp or londonAsiaBreakUp or nyLondonBreakUp or trendBreakUp or bullCandleAligned)
bool bearTrigger = enablePatterns and (retestDown or londonAsiaBreakDown or nyLondonBreakDown or trendBreakDown or bearCandleAligned)

var array<label> patternLabels = array.new<label>()
if showPatternLabels and barstate.isconfirmed and (bullCandleAligned or bearCandleAligned)
    bool bullishPattern = bullCandleAligned and not bearCandleAligned
    string patternText = bullishPattern ? "▲ " + bullPatternName : "▼ " + bearPatternName
    label patternLabel = label.new(bar_index, bullishPattern ? low : high, patternText, xloc = xloc.bar_index, style = bullishPattern ? label.style_label_up : label.style_label_down, color = color.new(C_PANEL, 18), textcolor = bullishPattern ? C_BULL : C_BEAR, size = size.tiny, tooltip = "Confirmed, context-aligned candle pattern. It contributes to the Price Action score family but does not predict the next move with certainty.")
    array.push(patternLabels, patternLabel)
    if array.size(patternLabels) > 12
        label.delete(array.shift(patternLabels))

// Confirmed higher-timeframe bundle: all fields use a one-bar offset with lookahead_on.
// The same five request contexts now carry EMA/RSI plus confirmed pivots in UDT objects.
// UDT transport also avoids Pine's combined tuple-element ceiling.
MtfData m1 = request.security(syminfo.tickerid, tf1, f_mtf_data(pivotEff), lookahead = barmerge.lookahead_on, calc_bars_count = requestBars)
MtfData m2 = request.security(syminfo.tickerid, tf2, f_mtf_data(pivotEff), lookahead = barmerge.lookahead_on, calc_bars_count = requestBars)
MtfData m3 = request.security(syminfo.tickerid, tf3, f_mtf_data(pivotEff), lookahead = barmerge.lookahead_on, calc_bars_count = requestBars)
MtfData m4 = request.security(syminfo.tickerid, tf4, f_mtf_data(pivotEff), lookahead = barmerge.lookahead_on, calc_bars_count = requestBars)
MtfData m5 = request.security(syminfo.tickerid, tf5, f_mtf_data(pivotEff), lookahead = barmerge.lookahead_on, calc_bars_count = requestBars)
bool tf1Usable = timeframe.in_seconds(tf1) >= chartSeconds
bool tf2Usable = timeframe.in_seconds(tf2) >= chartSeconds
bool tf3Usable = timeframe.in_seconds(tf3) >= chartSeconds
bool tf4Usable = timeframe.in_seconds(tf4) >= chartSeconds
bool tf5Usable = timeframe.in_seconds(tf5) >= chartSeconds
int mtf1 = enableMtf ? tf1Usable ? f_tf_state(m1.fast, m1.slow, m1.rsi) : 2 : 0
int mtf2 = enableMtf ? tf2Usable ? f_tf_state(m2.fast, m2.slow, m2.rsi) : 2 : 0
int mtf3 = enableMtf ? tf3Usable ? f_tf_state(m3.fast, m3.slow, m3.rsi) : 2 : 0
int mtf4 = enableMtf ? tf4Usable ? f_tf_state(m4.fast, m4.slow, m4.rsi) : 2 : 0
int mtf5 = enableMtf ? tf5Usable ? f_tf_state(m5.fast, m5.slow, m5.rsi) : 2 : 0
int mtfSum = (mtf1 == 2 ? 0 : mtf1) + (mtf2 == 2 ? 0 : mtf2) + (mtf3 == 2 ? 0 : mtf3) + (mtf4 == 2 ? 0 : mtf4) + (mtf5 == 2 ? 0 : mtf5)
int mtfAvailable = (mtf1 == 2 ? 0 : 1) + (mtf2 == 2 ? 0 : 1) + (mtf3 == 2 ? 0 : 1) + (mtf4 == 2 ? 0 : 1) + (mtf5 == 2 ? 0 : 1)
bool mtfConflict = mtfAvailable == 0 or math.abs(mtfSum) <= 1

float dcOldLow = channelDecisionTf == "TF 1" ? m1.oldLow : channelDecisionTf == "TF 2" ? m2.oldLow : channelDecisionTf == "TF 3" ? m3.oldLow : channelDecisionTf == "TF 5" ? m5.oldLow : m4.oldLow
float dcNewLow = channelDecisionTf == "TF 1" ? m1.newLow : channelDecisionTf == "TF 2" ? m2.newLow : channelDecisionTf == "TF 3" ? m3.newLow : channelDecisionTf == "TF 5" ? m5.newLow : m4.newLow
int dcOldLowTime = channelDecisionTf == "TF 1" ? m1.oldLowTime : channelDecisionTf == "TF 2" ? m2.oldLowTime : channelDecisionTf == "TF 3" ? m3.oldLowTime : channelDecisionTf == "TF 5" ? m5.oldLowTime : m4.oldLowTime
int dcNewLowTime = channelDecisionTf == "TF 1" ? m1.newLowTime : channelDecisionTf == "TF 2" ? m2.newLowTime : channelDecisionTf == "TF 3" ? m3.newLowTime : channelDecisionTf == "TF 5" ? m5.newLowTime : m4.newLowTime
float dcOldHigh = channelDecisionTf == "TF 1" ? m1.oldHigh : channelDecisionTf == "TF 2" ? m2.oldHigh : channelDecisionTf == "TF 3" ? m3.oldHigh : channelDecisionTf == "TF 5" ? m5.oldHigh : m4.oldHigh
float dcNewHigh = channelDecisionTf == "TF 1" ? m1.newHigh : channelDecisionTf == "TF 2" ? m2.newHigh : channelDecisionTf == "TF 3" ? m3.newHigh : channelDecisionTf == "TF 5" ? m5.newHigh : m4.newHigh
int dcOldHighTime = channelDecisionTf == "TF 1" ? m1.oldHighTime : channelDecisionTf == "TF 2" ? m2.oldHighTime : channelDecisionTf == "TF 3" ? m3.oldHighTime : channelDecisionTf == "TF 5" ? m5.oldHighTime : m4.oldHighTime
int dcNewHighTime = channelDecisionTf == "TF 1" ? m1.newHighTime : channelDecisionTf == "TF 2" ? m2.newHighTime : channelDecisionTf == "TF 3" ? m3.newHighTime : channelDecisionTf == "TF 5" ? m5.newHighTime : m4.newHighTime
string decisionChannelName = channelDecisionTf == "TF 1" ? f_tf_name(tf1) : channelDecisionTf == "TF 2" ? f_tf_name(tf2) : channelDecisionTf == "TF 3" ? f_tf_name(tf3) : channelDecisionTf == "TF 5" ? f_tf_name(tf5) : f_tf_name(tf4)
float decisionChannelSeconds = channelDecisionTf == "TF 1" ? timeframe.in_seconds(tf1) : channelDecisionTf == "TF 2" ? timeframe.in_seconds(tf2) : channelDecisionTf == "TF 3" ? timeframe.in_seconds(tf3) : channelDecisionTf == "TF 5" ? timeframe.in_seconds(tf5) : timeframe.in_seconds(tf4)
bool channelTfUsable = channelDecisionTf != "Off" and decisionChannelSeconds > chartSeconds
bool decisionChannelAsc = channelTfUsable and not na(dcOldLow) and not na(dcNewLow) and dcNewLowTime > dcOldLowTime and dcNewLow > dcOldLow
bool decisionChannelDesc = channelTfUsable and not na(dcOldHigh) and not na(dcNewHigh) and dcNewHighTime > dcOldHighTime and dcNewHigh < dcOldHigh
float decisionChannelSlope = decisionChannelAsc ? (dcNewLow - dcOldLow) / math.max(1, dcNewLowTime - dcOldLowTime) : decisionChannelDesc ? (dcNewHigh - dcOldHigh) / math.max(1, dcNewHighTime - dcOldHighTime) : na
float decisionChannelEdge = decisionChannelAsc ? dcOldLow + decisionChannelSlope * (time - dcOldLowTime) : decisionChannelDesc ? dcOldHigh + decisionChannelSlope * (time - dcOldHighTime) : na
bool nearChannelSupport = decisionChannelAsc and math.abs(close - decisionChannelEdge) <= atr * 0.65
bool nearChannelResistance = decisionChannelDesc and math.abs(close - decisionChannelEdge) <= atr * 0.65
bool channelBreakDown = decisionChannelAsc and close < decisionChannelEdge - atr * breakoutAtr and close[1] >= decisionChannelEdge[1] - atr * breakoutAtr
bool channelBreakUp = decisionChannelDesc and close > decisionChannelEdge + atr * breakoutAtr and close[1] <= decisionChannelEdge[1] + atr * breakoutAtr
bool channelRetestUp = decisionChannelDesc and ta.barssince(channelBreakUp) > 0 and ta.barssince(channelBreakUp) <= 12 and low <= decisionChannelEdge + atr * 0.25 and close > decisionChannelEdge
bool channelRetestDown = decisionChannelAsc and ta.barssince(channelBreakDown) > 0 and ta.barssince(channelBreakDown) <= 12 and high >= decisionChannelEdge - atr * 0.25 and close < decisionChannelEdge

var array<line> htfChannelLines = array.new<line>()
var array<label> htfChannelLabels = array.new<label>()
if barstate.islast
    f_clear_mtf(htfChannelLines, htfChannelLabels)
    bool htfOverlayEnabled = showHtfTrendlines and displayMode != "Radar Focus"
    f_draw_mtf_channel(htfChannelLines, htfChannelLabels, htfOverlayEnabled and showHtf1 and timeframe.in_seconds(tf1) > chartSeconds, f_tf_name(tf1), int(timeframe.in_seconds(tf1) * 1000), m1.oldLow, m1.oldLowTime, m1.newLow, m1.newLowTime, m1.oldHigh, m1.oldHighTime, m1.newHigh, m1.newHighTime)
    f_draw_mtf_channel(htfChannelLines, htfChannelLabels, htfOverlayEnabled and showHtf2 and timeframe.in_seconds(tf2) > chartSeconds, f_tf_name(tf2), int(timeframe.in_seconds(tf2) * 1000), m2.oldLow, m2.oldLowTime, m2.newLow, m2.newLowTime, m2.oldHigh, m2.oldHighTime, m2.newHigh, m2.newHighTime)
    f_draw_mtf_channel(htfChannelLines, htfChannelLabels, htfOverlayEnabled and showHtf3 and timeframe.in_seconds(tf3) > chartSeconds, f_tf_name(tf3), int(timeframe.in_seconds(tf3) * 1000), m3.oldLow, m3.oldLowTime, m3.newLow, m3.newLowTime, m3.oldHigh, m3.oldHighTime, m3.newHigh, m3.newHighTime)
    f_draw_mtf_channel(htfChannelLines, htfChannelLabels, htfOverlayEnabled and showHtf4 and timeframe.in_seconds(tf4) > chartSeconds, f_tf_name(tf4), int(timeframe.in_seconds(tf4) * 1000), m4.oldLow, m4.oldLowTime, m4.newLow, m4.newLowTime, m4.oldHigh, m4.oldHighTime, m4.newHigh, m4.newHighTime)
    f_draw_mtf_channel(htfChannelLines, htfChannelLabels, htfOverlayEnabled and showHtf5 and timeframe.in_seconds(tf5) > chartSeconds, f_tf_name(tf5), int(timeframe.in_seconds(tf5) * 1000), m5.oldLow, m5.oldLowTime, m5.newLow, m5.newLowTime, m5.oldHigh, m5.oldHighTime, m5.newHigh, m5.newHighTime)

float cryptoContextScore = 0
string cryptoNarrative = "Unavailable"
float btcCorrelation = na
if isCrypto and enableCrypto and resourceProfile != "Chart Focus"
    [btcDc, btcDr, btcDe, btcDa] = request.security(btcDomSymbol, timeframe.period, f_context_tuple(), ignore_invalid_symbol = true, calc_bars_count = requestBars)
    [usdtDc, usdtDr, usdtDe, usdtDa] = request.security(usdtDomSymbol, timeframe.period, f_context_tuple(), ignore_invalid_symbol = true, calc_bars_count = requestBars)
    [total2c, total2r, total2e, total2a] = request.security(total2Symbol, timeframe.period, f_context_tuple(), ignore_invalid_symbol = true, calc_bars_count = requestBars)
    [btcc, btcr, btce, btca] = request.security(btcSymbol, timeframe.period, f_context_tuple(), ignore_invalid_symbol = true, calc_bars_count = requestBars)
    float total3r = na
    if fullMacro
        [total3c_, total3r_, total3e_, total3a_] = request.security(total3Symbol, timeframe.period, f_context_tuple(), ignore_invalid_symbol = true, calc_bars_count = requestBars)
        [totalc_, totalr_, totale_, totala_] = request.security(totalSymbol, timeframe.period, f_context_tuple(), ignore_invalid_symbol = true, calc_bars_count = requestBars)
        [ethdc_, ethdr_, ethde_, ethda_] = request.security(ethDomSymbol, timeframe.period, f_context_tuple(), ignore_invalid_symbol = true, calc_bars_count = requestBars)
        [ethc_, ethr_, ethe_, etha_] = request.security(ethSymbol, timeframe.period, f_context_tuple(), ignore_invalid_symbol = true, calc_bars_count = requestBars)
        total3r := total3r_
    bool chartIsBtc = str.contains(str.upper(syminfo.ticker), "BTC")
    bool chartIsEth = str.contains(str.upper(syminfo.ticker), "ETH")
    bool chartIsAlt = not chartIsBtc and not chartIsEth
    float broadCrypto = (nz(total2r) > 0 ? 1.5 : -1.5) + (nz(usdtDr) < 0 ? 1.5 : -1.5) + (nz(btcr) > 0 ? 1 : -1)
    float leadershipAdjustment = chartIsBtc ? (nz(btcDr) > 0 ? 1.5 : -0.5) : chartIsAlt ? (nz(btcDr) < 0 ? 1.5 : -1.5) : 0
    cryptoContextScore := f_clamp(broadCrypto + leadershipAdjustment, -contextWeight, contextWeight)
    cryptoNarrative := nz(usdtDr) > 0 and nz(total2r) < 0 ? "Altcoins under pressure" : chartIsAlt and nz(total2r) > nz(btcr) and nz(btcDr) < 0 ? "Possible altcoin rotation" : chartIsBtc and nz(btcr) > 0 and nz(btcDr) > 0 ? "BTC leadership" : nz(usdtDr) < 0 and nz(total2r) > 0 ? "Risk returning to crypto" : "Crypto context conflicted"
    btcCorrelation := ta.correlation(close, btcc, 50)

float fxContextScore = 0
string fxNarrative = "Unavailable"
float baseStrength = na
float quoteStrength = na
if isForex and enableForex and resourceProfile != "Chart Focus"
    string b = syminfo.basecurrency
    string q = syminfo.currency
    [eurusd, eurusdR, euE, euA] = request.security(fxPrefix + "EURUSD", timeframe.period, f_context_tuple(), ignore_invalid_symbol = true, calc_bars_count = requestBars)
    [gbpusd, gbpusdR, guE, guA] = request.security(fxPrefix + "GBPUSD", timeframe.period, f_context_tuple(), ignore_invalid_symbol = true, calc_bars_count = requestBars)
    [usdjpy, usdjpyR, ujE, ujA] = request.security(fxPrefix + "USDJPY", timeframe.period, f_context_tuple(), ignore_invalid_symbol = true, calc_bars_count = requestBars)
    [audusd, audusdR, auE, auA] = request.security(fxPrefix + "AUDUSD", timeframe.period, f_context_tuple(), ignore_invalid_symbol = true, calc_bars_count = requestBars)
    [usdcad, usdcadR, ucE, ucA] = request.security(fxPrefix + "USDCAD", timeframe.period, f_context_tuple(), ignore_invalid_symbol = true, calc_bars_count = requestBars)
    [usdchf, usdchfR, ufE, ufA] = request.security(fxPrefix + "USDCHF", timeframe.period, f_context_tuple(), ignore_invalid_symbol = true, calc_bars_count = requestBars)
    float usd = (-nz(eurusdR) - nz(gbpusdR) + nz(usdjpyR) - nz(audusdR) + nz(usdcadR) + nz(usdchfR)) / 6
    baseStrength := f_currency_strength(b, usd, nz(eurusdR), nz(gbpusdR), -nz(usdjpyR), nz(audusdR), -nz(usdcadR), -nz(usdchfR))
    quoteStrength := f_currency_strength(q, usd, nz(eurusdR), nz(gbpusdR), -nz(usdjpyR), nz(audusdR), -nz(usdcadR), -nz(usdchfR))
    fxContextScore := f_clamp((baseStrength - quoteStrength) / 2, -contextWeight, contextWeight)
    fxNarrative := b + " " + (baseStrength > quoteStrength ? "stronger" : "weaker") + " than " + q

float globalContextScore = 0
string globalNarrative = "Reduced by profile"
if enableGlobal and (balancedContext or fullMacro)
    [vixc, vixr, vixe, vixa] = request.security(vixSymbol, timeframe.period, f_context_tuple(), ignore_invalid_symbol = true, calc_bars_count = requestBars)
    [dxyc, dxyr, dxye, dxya] = request.security(dxySymbol, timeframe.period, f_context_tuple(), ignore_invalid_symbol = true, calc_bars_count = requestBars)
    [spxc, spxr, spxe, spxa] = request.security(spxSymbol, timeframe.period, f_context_tuple(), ignore_invalid_symbol = true, calc_bars_count = requestBars)
    float y10r = na
    float y2r = na
    float goldr = na
    if fullMacro
        [y10c_, y10r_, y10e_, y10a_] = request.security(us10ySymbol, timeframe.period, f_context_tuple(), ignore_invalid_symbol = true, calc_bars_count = requestBars)
        [y2c_, y2r_, y2e_, y2a_] = request.security(us2ySymbol, timeframe.period, f_context_tuple(), ignore_invalid_symbol = true, calc_bars_count = requestBars)
        [goldc_, goldr_, golde_, golda_] = request.security(goldSymbol, timeframe.period, f_context_tuple(), ignore_invalid_symbol = true, calc_bars_count = requestBars)
        [ndxc_, ndxr_, ndxe_, ndxa_] = request.security(ndxSymbol, timeframe.period, f_context_tuple(), ignore_invalid_symbol = true, calc_bars_count = requestBars)
        [oilc_, oilr_, oile_, oila_] = request.security(oilSymbol, timeframe.period, f_context_tuple(), ignore_invalid_symbol = true, calc_bars_count = requestBars)
        y10r := y10r_
        y2r := y2r_
        goldr := goldr_
    float equityRisk = (nz(spxr) > 0 ? 2 : -2) + (nz(vixr) < 0 ? 1.5 : -1.5)
    bool goldLike = str.contains(str.upper(syminfo.ticker), "GOLD") or str.contains(str.upper(syminfo.ticker), "XAU")
    bool usdLike = str.contains(str.upper(syminfo.ticker), "DXY")
    bool equityLike = isStock or marketType == "Index"
    globalContextScore := f_clamp(goldLike ? (nz(dxyr) < 0 ? 2 : -2) + (nz(vixr) > 0 ? 1 : -1) : usdLike ? (nz(dxyr) > 0 ? 3 : -3) : equityLike ? equityRisk : 0, -contextWeight, contextWeight)
    globalNarrative := goldLike ? (nz(dxyr) < 0 ? "Gold tailwind · USD softer" : "Gold headwind · USD firmer") : usdLike ? (nz(dxyr) > 0 ? "USD strength" : "USD weakness") : equityLike and nz(vixr) > 0 and nz(spxr) < 0 ? "Risk-off · equity pressure" : equityLike and nz(vixr) < 0 and nz(spxr) > 0 ? "Risk-on · volatility easing" : "Intermarket context not mapped to this asset"

float econ1 = na
float econ2 = na
float stockRevenue = na
float stockNetIncome = na
string econCountry1Eff = autoMapEconomic and isForex ? f_econ_country(syminfo.basecurrency) : econCountry1
string econCountry2Eff = autoMapEconomic and isForex ? f_econ_country(syminfo.currency) : econCountry2
if enableEconomic and fullMacro
    econ1 := request.economic(econCountry1Eff, econField1, gaps = barmerge.gaps_off, ignore_invalid_symbol = true)
    econ2 := request.economic(econCountry2Eff, econField2, gaps = barmerge.gaps_off, ignore_invalid_symbol = true)
if isStock and enableStockFinancials and fullMacro
    stockRevenue := request.financial(syminfo.tickerid, "TOTAL_REVENUE", "FQ", gaps = barmerge.gaps_off, ignore_invalid_symbol = true)
    stockNetIncome := request.financial(syminfo.tickerid, "NET_INCOME", "FQ", gaps = barmerge.gaps_off, ignore_invalid_symbol = true)

bool event1Active = f_in_event(event1Time) and f_market_matches(event1Market)
bool event2Active = f_in_event(event2Time) and f_market_matches(event2Market)
bool event3Active = f_in_event(event3Time) and f_market_matches(event3Market)
bool highEventRisk = event1Active and event1Impact == "High" or event2Active and event2Impact == "High" or event3Active and event3Impact == "High"
int highTime1 = event1Impact == "High" and event1Time > 0 and f_market_matches(event1Market) ? event1Time : 0
int highTime2 = event2Impact == "High" and event2Time > 0 and f_market_matches(event2Market) ? event2Time : 0
int highTime3 = event3Impact == "High" and event3Time > 0 and f_market_matches(event3Market) ? event3Time : 0
int latestHighEventTime = math.max(highTime1, math.max(highTime2, highTime3))
int barsAfterHighEvent = latestHighEventTime > 0 ? ta.barssince(time[1] < latestHighEventTime and time >= latestHighEventTime) : na
bool postEventSafetyHold = eventBehavior == "Hard Blackout" and not na(barsAfterHighEvent) and barsAfterHighEvent >= 0 and barsAfterHighEvent < postEventClosedBars
bool eventBlackout = highEventRisk and (eventBehavior == "Hard Blackout" or eventBehavior == "Block Candidate") or postEventSafetyHold
bool anyEventConfigured = event1Time > 0 or event2Time > 0 or event3Time > 0
string eventName = event1Active ? event1Name : event2Active ? event2Name : event3Active ? event3Name : ""
int eventTime = event1Active ? event1Time : event2Active ? event2Time : event3Active ? event3Time : 0
string eventForecast = event1Active ? event1Forecast : event2Active ? event2Forecast : event3Active ? event3Forecast : ""
string eventPrevious = event1Active ? event1Previous : event2Active ? event2Previous : event3Active ? event3Previous : ""
string eventStatus = not anyEventConfigured ? "NO MANUAL EVENT CONFIGURED" : postEventSafetyHold ? "POST-EVENT HOLD · " + str.tostring(math.max(0, postEventClosedBars - barsAfterHighEvent)) + " BARS" : highEventRisk and timenow < eventTime ? "HIGH IMPACT IN " + str.tostring(math.max(0, math.round((eventTime - timenow) / 60000))) + "m" : highEventRisk and timenow >= eventTime ? "EVENT BLACKOUT ACTIVE" : event1Active or event2Active or event3Active ? "EVENT RISK ACTIVE" : "NO ACTIVE EVENT WINDOW"
float eventMoveAtr = eventTime > 0 and time >= eventTime ? (close - ta.valuewhen(time[1] < eventTime and time >= eventTime, open, 0)) / atr : na
string eventReaction = na(eventMoveAtr) ? "Observed reaction pending" : math.abs(eventMoveAtr) < 0.5 ? "Muted observed reaction" : eventMoveAtr > 0 ? "Observed move up · " + str.tostring(eventMoveAtr, "#.##") + " ATR" : "Observed move down · " + str.tostring(math.abs(eventMoveAtr), "#.##") + " ATR"
int eventBarsSince = eventTime > 0 ? ta.barssince(time[1] < eventTime and time >= eventTime) : na
string reactionState = not na(eventBarsSince) and eventBarsSince >= reactionBars ? math.sign(close - nz(ta.valuewhen(time[1] < eventTime and time >= eventTime, close, 0), close)) == math.sign(nz(eventMoveAtr)) ? "continued" : "faded" : "developing"

// Decision engine: a candidate must pass independent Context → Location → Trigger → Economics gates.
// EMA is supporting context only; it cannot produce a candidate by itself.
float tentativeLongStop = (not na(nearestSupport) ? nearestSupport : nz(lastLow, low)) - atr * 0.20
float tentativeShortStop = (not na(nearestResistance) ? nearestResistance : nz(lastHigh, high)) + atr * 0.20
float tentativeLongRisk = math.abs(close - tentativeLongStop)
float tentativeShortRisk = math.abs(tentativeShortStop - close)
float tentativeLongTarget = not na(nearestResistance) and nearestResistance > close ? nearestResistance : close + tentativeLongRisk * 2.5
float tentativeShortTarget = not na(nearestSupport) and nearestSupport < close ? nearestSupport : close - tentativeShortRisk * 2.5
float tentativeCost = close * feePct / 100 + (spreadTicks + slippageTicks) * syminfo.mintick
float tentativeLongNetRR = tentativeLongRisk > 0 ? (math.abs(tentativeLongTarget - close) * contractMultiplier - tentativeCost) / (tentativeLongRisk * contractMultiplier + tentativeCost) : na
float tentativeShortNetRR = tentativeShortRisk > 0 ? (math.abs(close - tentativeShortTarget) * contractMultiplier - tentativeCost) / (tentativeShortRisk * contractMultiplier + tentativeCost) : na
bool longStopTooWide = tentativeLongRisk > atr * maxStopAtr
bool shortStopTooWide = tentativeShortRisk > atr * maxStopAtr
bool longEconomicsPass = not na(tentativeLongNetRR) and tentativeLongNetRR >= minRR and (not rejectWideStops or not longStopTooWide)
bool shortEconomicsPass = not na(tentativeShortNetRR) and tentativeShortNetRR >= minRR and (not rejectWideStops or not shortStopTooWide)
bool longContext = structureDir > 0 and mtfSum >= 1
bool shortContext = structureDir < 0 and mtfSum <= -1
bool longLocation = nearSupport or nearChannelSupport
bool shortLocation = nearResistance or nearChannelResistance
bool longTrigger = bullCandleAligned or retestUp or channelRetestUp or londonAsiaBreakUp or trendBreakUp
bool shortTrigger = bearCandleAligned or retestDown or channelRetestDown or londonAsiaBreakDown or trendBreakDown
bool longSweepPlaybook = sweepLow and bullCandleAligned and (structureDir >= 0 or mtfSum >= 0)
bool shortSweepPlaybook = sweepHigh and bearCandleAligned and (structureDir <= 0 or mtfSum <= 0)
bool longBreakRetestPlaybook = (retestUp or channelRetestUp) and longContext
bool shortBreakRetestPlaybook = (retestDown or channelRetestDown) and shortContext
bool longTrendPullbackPlaybook = longContext and longLocation and longTrigger
bool shortTrendPullbackPlaybook = shortContext and shortLocation and shortTrigger
bool longSetupReady = longTrendPullbackPlaybook or longBreakRetestPlaybook or longSweepPlaybook
bool shortSetupReady = shortTrendPullbackPlaybook or shortBreakRetestPlaybook or shortSweepPlaybook
string longPlaybookName = longSweepPlaybook ? "Liquidity Sweep Reversal" : longBreakRetestPlaybook ? "Breakout Retest" : "Trend Pullback"
string shortPlaybookName = shortSweepPlaybook ? "Liquidity Sweep Reversal" : shortBreakRetestPlaybook ? "Breakout Retest" : "Trend Pullback"
float participationScore = abnormalVol ? 10 : volumeAvailable and relativeVolume >= 1 ? 7 : not volumeAvailable ? 3 : 0
float timingScore = overlapActive ? 5 : londonActive or nyActive ? 4 : asiaActive ? 2 : 0
float directionalContext = isCrypto ? cryptoContextScore : isForex ? fxContextScore : globalContextScore
float longScore = (longContext ? 20 : 0) + (longLocation ? 20 : 0) + (longTrigger ? 20 : 0) + participationScore + timingScore + math.max(0, directionalContext) + (longEconomicsPass ? 20 : 0)
float shortScore = (shortContext ? 20 : 0) + (shortLocation ? 20 : 0) + (shortTrigger ? 20 : 0) + participationScore + timingScore + math.max(0, -directionalContext) + (shortEconomicsPass ? 20 : 0)
if lowVolume
    longScore -= 7
    shortScore -= 7
if excessiveVol or highEventRisk and eventBehavior == "Reduce Score"
    longScore -= excessiveVol ? 8 : eventPenaltyInput
    shortScore -= excessiveVol ? 8 : eventPenaltyInput
longScore := f_clamp(longScore, 0, 100)
shortScore := f_clamp(shortScore, 0, 100)

int rawDirection = longSetupReady and longEconomicsPass and (not shortSetupReady or longScore > shortScore) ? 1 : shortSetupReady and shortEconomicsPass ? -1 : 0
float rawScore = rawDirection > 0 ? longScore : rawDirection < 0 ? shortScore : math.max(longScore, shortScore)
string rawSetupName = rawDirection > 0 ? longPlaybookName : rawDirection < 0 ? shortPlaybookName : "No Complete Setup"
string waitingFor = rawDirection != 0 ? "Ready" : longContext and longLocation ? "WAIT FOR BULLISH TRIGGER" : shortContext and shortLocation ? "WAIT FOR BEARISH TRIGGER" : longContext ? "WAIT FOR LONG LOCATION" : shortContext ? "WAIT FOR SHORT LOCATION" : "WAIT FOR CONTEXT"
bool barConfirmed = not confirmClose or barstate.isconfirmed
bool blockedByEvent = eventBlackout
var int candidatesToday = 0
var int consecutiveStops = 0
var int lastStopBar = na
var float plannedRiskToday = 0
bool newTradingDay = ta.change(time("D")) != 0
if newTradingDay
    candidatesToday := 0
    plannedRiskToday := 0
float configuredRiskCapital = riskMode == "Percentage" ? accountBalance * riskPct / 100 : fixedRisk
bool dailyPlanLimit = candidatesToday >= maxCandidatesPerDay
bool dailyRiskLimit = plannedRiskToday + configuredRiskCapital > accountBalance * dailyRiskBudgetPct / 100
bool stopStreakCooldown = consecutiveStops >= maxConsecutiveStops and not na(lastStopBar) and bar_index - lastStopBar < stopCooldownBars
string guardrailReason = eventBlackout ? eventStatus : dailyPlanLimit ? "DAILY PLAN LIMIT" : dailyRiskLimit ? "DAILY RISK BUDGET" : stopStreakCooldown ? "STOP-STREAK COOLDOWN" : ""
bool candidate = signalsAllowed and barConfirmed and rawDirection != 0 and rawScore >= minScoreEff and not blockedByEvent and not dailyPlanLimit and not dailyRiskLimit and not stopStreakCooldown
bool earlyWatch = signalsAllowed and (longContext and longLocation or shortContext and shortLocation) and not candidate
bool contextGate = rawDirection > 0 ? longContext : rawDirection < 0 ? shortContext : false
bool locationGate = rawDirection > 0 ? longLocation : rawDirection < 0 ? shortLocation : false
bool triggerGate = rawDirection > 0 ? longTrigger : rawDirection < 0 ? shortTrigger : false
bool economicsGate = rawDirection > 0 ? longEconomicsPass : rawDirection < 0 ? shortEconomicsPass : false
bool safetyGate = guardrailReason == ""
int readinessCount = (contextGate ? 1 : 0) + (locationGate ? 1 : 0) + (triggerGate ? 1 : 0) + (economicsGate ? 1 : 0) + (safetyGate ? 1 : 0)
string readinessText = "C" + (contextGate ? "✓" : "·") + " L" + (locationGate ? "✓" : "·") + " T" + (triggerGate ? "✓" : "·") + " E" + (economicsGate ? "✓" : "·") + " S" + (safetyGate ? "✓" : "!")
string qualityText = rawDirection == 0 ? "WATCH" : readinessCount == 5 and rawScore >= 80 ? "QUALITY A" : readinessCount == 5 and rawScore >= minScoreEff ? "QUALITY B" : "WATCH"

var string signalState = "None"
var int signalDirection = 0
var float entry = na
var float stop = na
var float tp1 = na
var float tp2 = na
var float tp3 = na
var float activeScore = na
var string setupName = "No Setup"
var int activatedBar = na
var int lastPlanEndBar = na
var int lastPlanDirection = 0
var bool tp1Hit = false
var bool tp2Hit = false
var bool tp3Hit = false
var bool breakEvenApplied = false
var string activeQuality = "WATCH"
var array<string> closedPlanHistory = array.new_string()
bool newCandidate = false
bool invalidatedNow = false
bool stoppedNow = false
bool target1Now = false
bool target2Now = false
bool target3Now = false
bool ambiguousBar = false

bool activeState = signalState == "Candidate" or signalState == "Confirmed" or signalState == "Active Plan" or signalState == "TP1 Hit" or signalState == "Protected" or signalState == "TP2 Hit" or signalState == "Runner"
bool cooldownPassed = na(lastPlanEndBar) or bar_index - lastPlanEndBar >= reentryCooldownBars
bool currentFreshTrigger = rawDirection > 0 ? longTrigger : rawDirection < 0 ? shortTrigger : false
bool reentryAllowed = cooldownPassed and (not requireFreshTrigger or currentFreshTrigger or rawDirection != lastPlanDirection)
if activeState
    invalidatedNow := signalDirection > 0 ? low <= stop : high >= stop
    stoppedNow := invalidatedNow
    target1Now := not tp1Hit and (signalDirection > 0 ? high >= tp1 : low <= tp1)
    target2Now := not tp2Hit and (signalDirection > 0 ? high >= tp2 : low <= tp2)
    target3Now := not tp3Hit and (signalDirection > 0 ? high >= tp3 : low <= tp3)
    ambiguousBar := invalidatedNow and (target1Now or target2Now or target3Now)
    if ambiguousBar
        target1Now := false
        target2Now := false
        target3Now := false
    tp1Hit := tp1Hit or target1Now
    tp2Hit := tp2Hit or target2Now
    tp3Hit := tp3Hit or target3Now
    if invalidatedNow
        signalState := ambiguousBar ? "Ambiguous Bar" : "Closed Stop"
    else if target3Now
        signalState := "Closed TP3"
    else if target2Now
        signalState := trailAfterTp2 ? "Runner" : "TP2 Hit"
    else if target1Now
        if afterTp1Action == "Move Stop To Break-even"
            stop := entry
            breakEvenApplied := true
            signalState := "Protected"
        else
            signalState := "TP1 Hit"
    else if expirePlanAtHighEvent and highEventRisk
        signalState := "Expired Event"
    else if bar_index - activatedBar > structureExpiry
        signalState := "Expired"
    else if tp2Hit and trailAfterTp2
        signalState := "Runner"
    else if tp1Hit and breakEvenApplied
        signalState := "Protected"
    else
        signalState := "Active Plan"
else if candidate and reentryAllowed and (signalState == "None" or signalState == "Early Watch" or signalState == "High Risk" or signalState == "Expired" or signalState == "Expired Event" or signalState == "Invalidated" or signalState == "Target Reached" or signalState == "Closed Stop" or signalState == "Closed TP3" or signalState == "Ambiguous Bar")
    signalState := "Candidate"
    signalDirection := rawDirection
    entry := close
    float structuralStop = rawDirection > 0 ? tentativeLongStop : tentativeShortStop
    float structuralDistance = math.abs(entry - structuralStop)
    stop := structuralStop
    tp1 := rawDirection > 0 ? entry + structuralDistance * 1.5 : entry - structuralDistance * 1.5
    tp2 := rawDirection > 0 ? tentativeLongTarget : tentativeShortTarget
    tp3 := rawDirection > 0 ? math.max(tp2, entry + structuralDistance * 3.5) : math.min(tp2, entry - structuralDistance * 3.5)
    activeScore := rawScore
    setupName := rawSetupName
    activeQuality := qualityText
    activatedBar := bar_index
    tp1Hit := false
    tp2Hit := false
    tp3Hit := false
    breakEvenApplied := false
    candidatesToday += 1
    plannedRiskToday += configuredRiskCapital
    newCandidate := true
else if earlyWatch and not activeState
    signalState := "Early Watch"
else if not activeState and not earlyWatch and signalState != "Closed Stop" and signalState != "Closed TP3" and signalState != "Ambiguous Bar"
    signalState := highEventRisk and eventBehavior == "High-Risk Warning" ? "High Risk" : "None"

float stopDistance = math.abs(entry - stop)
float costPerUnit = entry * feePct / 100 + (spreadTicks + slippageTicks) * syminfo.mintick
float riskCapital = riskMode == "Percentage" ? accountBalance * riskPct / 100 : fixedRisk
float netRiskPerUnit = stopDistance * contractMultiplier + costPerUnit
float units = netRiskPerUnit > 0 ? riskCapital / netRiskPerUnit : na
float notional = units * entry * contractMultiplier
float suggestedLeverage = isCrypto ? math.min(leverageCap, 100 / liquidationBufferPct) : 1
float estimatedMargin = isCrypto ? notional / suggestedLeverage : notional
float netRR = stopDistance > 0 ? (math.abs(tp2 - entry) * contractMultiplier - costPerUnit) / netRiskPerUnit : na
float forexLots = isForex and forexLotUnits > 0 ? units / forexLotUnits : na
float forexStopPips = isForex and pipSizeInput > 0 ? stopDistance / pipSizeInput : na
bool weakEconomics = not na(netRR) and netRR < minRR

var line entryLine = na
var line stopLine = na
var line tp1Line = na
var line tp2Line = na
var line tp3Line = na
var box riskBox = na
var box rewardBox = na
var array<line> archivedPlanLines = array.new<line>()
var array<label> archivedPlanLabels = array.new<label>()
if newCandidate and showRiskPlan and displayMode != "Radar Focus"
    line.delete(entryLine), line.delete(stopLine), line.delete(tp1Line), line.delete(tp2Line), line.delete(tp3Line)
    box.delete(riskBox), box.delete(rewardBox)
    entryLine := line.new(bar_index, entry, bar_index + 25, entry, color = C_INFO, extend = extend.none)
    stopLine := line.new(bar_index, stop, bar_index + 25, stop, color = C_BEAR, width = 2)
    tp1Line := line.new(bar_index, tp1, bar_index + 25, tp1, color = C_BULL)
    tp2Line := line.new(bar_index, tp2, bar_index + 25, tp2, color = C_BULL)
    tp3Line := line.new(bar_index, tp3, bar_index + 25, tp3, color = C_BULL, style = line.style_dashed)
    if showRiskZones
        riskBox := box.new(bar_index, math.max(entry, stop), bar_index + 25, math.min(entry, stop), bgcolor = color.new(C_BEAR, 94), border_color = color.new(C_BEAR, 72))
        rewardBox := box.new(bar_index, math.max(entry, tp3), bar_index + 25, math.min(entry, tp3), bgcolor = color.new(C_BULL, 95), border_color = color.new(C_BULL, 72))
if activeState and showRiskPlan and displayMode != "Radar Focus" and not na(entryLine)
    line.set_x2(entryLine, bar_index + 1), line.set_x2(stopLine, bar_index + 1), line.set_x2(tp1Line, bar_index + 1), line.set_x2(tp2Line, bar_index + 1), line.set_x2(tp3Line, bar_index + 1)
    line.set_y1(stopLine, stop), line.set_y2(stopLine, stop)
    if showRiskZones and not na(riskBox)
        box.set_right(riskBox, bar_index + 1), box.set_right(rewardBox, bar_index + 1)
bool planEndedNow = (signalState == "Closed Stop" or signalState == "Closed TP3" or signalState == "Expired" or signalState == "Expired Event" or signalState == "Ambiguous Bar") and signalState != signalState[1]
if planEndedNow
    lastPlanEndBar := bar_index
    lastPlanDirection := signalDirection
    if signalState == "Ambiguous Bar" or signalState == "Closed Stop" and not breakEvenApplied
        consecutiveStops += 1
        lastStopBar := bar_index
    else
        consecutiveStops := 0
    if closedPlanHistorySize > 0
        string closedSummary = (signalDirection > 0 ? "▲ " : "▼ ") + setupName + " · " + signalState + (tp1Hit ? " · TP1" : "") + (tp2Hit ? " · TP2" : "")
        array.push(closedPlanHistory, closedSummary)
        if array.size(closedPlanHistory) > closedPlanHistorySize
            array.shift(closedPlanHistory)
    if showArchivedPlans and archivedPlanLimit > 0 and showRiskPlan and displayMode != "Radar Focus"
        color archiveMain = signalState == "Closed TP3" ? C_BULL : signalState == "Closed Stop" ? C_BEAR : C_WARN
        line archivedEntry = line.new(activatedBar, entry, bar_index, entry, color = color.new(C_INFO, 82), width = 1)
        line archivedStop = line.new(activatedBar, stop, bar_index, stop, color = color.new(C_BEAR, 82), width = 1)
        line archivedTp1 = line.new(activatedBar, tp1, bar_index, tp1, color = color.new(C_BULL, 86), width = 1)
        line archivedTp2 = line.new(activatedBar, tp2, bar_index, tp2, color = color.new(C_BULL, 86), width = 1)
        line archivedTp3 = line.new(activatedBar, tp3, bar_index, tp3, color = color.new(C_BULL, 88), width = 1, style = line.style_dashed)
        array.push(archivedPlanLines, archivedEntry)
        array.push(archivedPlanLines, archivedStop)
        array.push(archivedPlanLines, archivedTp1)
        array.push(archivedPlanLines, archivedTp2)
        array.push(archivedPlanLines, archivedTp3)
        label archivedTag = label.new(bar_index, entry, "ARCHIVED · " + signalState, style = signalDirection > 0 ? label.style_label_down : label.style_label_up, color = color.new(C_PANEL, 45), textcolor = color.new(archiveMain, 25), size = size.tiny, tooltip = "Finished Quantara model plan. This is not a broker-confirmed fill record.")
        array.push(archivedPlanLabels, archivedTag)
        if array.size(archivedPlanLabels) > archivedPlanLimit
            label.delete(array.shift(archivedPlanLabels))
            for archiveLine = 0 to 4
                line.delete(array.shift(archivedPlanLines))
    line.delete(entryLine), line.delete(stopLine), line.delete(tp1Line), line.delete(tp2Line), line.delete(tp3Line)
    box.delete(riskBox), box.delete(rewardBox)
    entryLine := na
    stopLine := na
    tp1Line := na
    tp2Line := na
    tp3Line := na
    riskBox := na
    rewardBox := na

plot(showVwap and volumeAvailable ? vwapValue : na, "VWAP", color.new(C_CRYPTO, 20), 1, display = display.pane)
plot(showFastEma ? emaFast : na, "Fast EMA", color.new(C_INFO, 45), 1, display = display.pane)
plot(showSlowEma ? emaSlow : na, "Slow EMA", color.new(C_NEUTRAL, 45), 1, display = display.pane)
barcolor(colorBars ? color.new(f_dir_color(structureDir), 65) : na)

f_radar_score(string symbol) =>
    [rc, rf, rs, rr, rv, rva, ra] = request.security(symbol, radarTf, f_radar_tuple(), ignore_invalid_symbol = true, calc_bars_count = requestBars)
    int rd = na(rc) ? 0 : rf > rs and rr > 52 ? 1 : rf < rs and rr < 48 ? -1 : 0
    float rvol = not na(rv) and rva > 0 ? rv / rva : na
    float score = na(rc) ? na : f_clamp(45 + math.abs(rr - 50) * 1.2 + (not na(rvol) and rvol > 1.2 ? 10 : 0) + (rd != 0 ? 10 : 0), 0, 100)
    [score, rd, rvol, rc, ra]

var array<string> radarSymbols = array.from(r1, r2, r3, r4, r5, r6, r7, r8, r9, r10)
var array<float> radarScores = array.new_float(10, na)
var array<int> radarDirs = array.new_int(10, 0)
var array<float> radarVols = array.new_float(10, na)
var array<int> radarPrevDirs = array.new_int(10, 0)
var array<bool> radarChanged = array.new_bool(10, false)
var array<int> radarOrder = array.new_int()
var bool radarReadyForChanges = false
if showRadarEff
    for i = 0 to radarLimit - 1
        [rs_, rd_, rv_, rc_, ra_] = f_radar_score(array.get(radarSymbols, i))
        int priorDirection = array.get(radarPrevDirs, i)
        array.set(radarScores, i, rs_)
        array.set(radarDirs, i, rd_)
        array.set(radarVols, i, rv_)
        array.set(radarChanged, i, radarReadyForChanges and not na(rs_) and rd_ != priorDirection)
        if not na(rs_)
            array.set(radarPrevDirs, i, rd_)
    array.clear(radarOrder)
    for i = 0 to radarLimit - 1
        array.push(radarOrder, i)
    if radarLimit > 1
        for i = 0 to radarLimit - 2
            for j = i + 1 to radarLimit - 1
                int leftIndex = array.get(radarOrder, i)
                int rightIndex = array.get(radarOrder, j)
                float leftScore = nz(array.get(radarScores, leftIndex), -1)
                float rightScore = nz(array.get(radarScores, rightIndex), -1)
                if rightScore > leftScore
                    array.set(radarOrder, i, rightIndex)
                    array.set(radarOrder, j, leftIndex)
if barstate.islastconfirmedhistory
    radarReadyForChanges := true

var table panel = table.new(f_pos(panelPos), 4, 30, bgcolor = color.new(C_PANEL, 4), frame_color = C_BORDER, frame_width = 1, border_color = C_BORDER)
f_cell(int c, int r, string txt, color txtColor = #E6EDF3, color bg = #111821, string align = text.align_left, string tip = "") => table.cell(panel, c, r, txt, text_color = txtColor, bgcolor = bg, text_size = panelSizeEff, text_halign = align, tooltip = showTooltips ? tip : "")
if barstate.islast
    table.clear(panel, 0, 0, 3, 29)
    int row = 0
    if showSignalPanel
        color stateColor = signalState == "Closed Stop" or signalState == "Ambiguous Bar" ? C_BEAR : signalState == "Closed TP3" ? C_BULL : signalDirection > 0 ? C_BULL : signalDirection < 0 ? C_BEAR : signalState == "High Risk" or eventBlackout ? C_WARN : C_NEUTRAL
        string panelQuality = activeState ? activeQuality : qualityText
        string stateText = signalState == "Candidate" or signalState == "Active Plan" ? (signalDirection > 0 ? "▲ LONG ACTIVE" : "▼ SHORT ACTIVE") : signalState == "Protected" ? "◈ TP1 · PROTECTED" : signalState == "Runner" ? "◈ TP2 · RUNNER" : signalState == "TP1 Hit" ? "◈ TP1 HIT" : signalState == "TP2 Hit" ? "◈ TP2 HIT" : signalState == "Early Watch" ? "◆ EARLY WATCH" : signalState == "Closed Stop" ? "× CLOSED · STOP" : signalState == "Closed TP3" ? "✓ CLOSED · TP3" : signalState == "Ambiguous Bar" ? "⚠ AMBIGUOUS BAR" : signalState == "Expired Event" ? "⛔ EXPIRED · EVENT" : signalState == "High Risk" or eventBlackout ? "⛔ NO NEW TRADES" : "— NO TRADE"
        string guideTip = "Color guide: teal ▲ = bullish/support/target; coral ▼ = bearish/resistance/stop; amber ◆ = wait or warning; blue = entry or information; purple = broader context. Signals are decision support, not certainty."
        f_cell(0, row, "QUANTARA VISION", C_CRYPTO), f_cell(1, row, "v0.6.0" + (showGuide ? " ⓘ" : ""), C_MUTED, C_PANEL, text.align_left, showGuide ? guideTip : ""), f_cell(2, row, syminfo.ticker, C_TEXT), f_cell(3, row, timeframe.period, C_MUTED), row += 1
        f_cell(0, row, stateText, stateColor, C_PANEL, text.align_left, "Current setup lifecycle. Candidate means conditions passed the score threshold; it does not imply certainty."), f_cell(1, row, activeState ? setupName : rawSetupName, C_TEXT, C_PANEL, text.align_left, "Detected setup family. Candle patterns contribute only when aligned with structure, level, trend, session, sweep, or retest context."), f_cell(2, row, "SCORE", C_MUTED, C_PANEL, text.align_left, "Explainable confidence score from 0 to 100 after penalties. Higher is stronger, not certain."), f_cell(3, row, str.tostring(math.round(activeState ? activeScore : rawScore)) + " · " + panelQuality, panelQuality == "QUALITY A" ? C_BULL : panelQuality == "QUALITY B" ? C_INFO : C_WARN, C_PANEL, text.align_right, "Quality A requires all five independent readiness checks and score 80+. Quality B requires all checks and the configured minimum score. Neither is a win-rate claim."), row += 1
        f_cell(0, row, "REGIME", C_MUTED, C_PANEL, text.align_left, "Confirmed structure and EMA context: BULL, BEAR, or RANGE."), f_cell(1, row, f_dir_text(structureDir), f_dir_color(structureDir)), f_cell(2, row, "SESSION", C_MUTED, C_PANEL, text.align_left, marketStatusTip), f_cell(3, row, showMarketStatus ? marketStatus : activeSession, C_INFO, C_PANEL, text.align_left, marketStatusTip), row += 1
        if not activeState and displayMode != "Minimal"
            f_cell(0, row, "NEXT ACTION", C_INFO, C_PANEL, text.align_left, "Decision ladder: Context → Location → Trigger → Economics. This states the first missing gate or a hard safety block."), f_cell(1, row, guardrailReason != "" ? guardrailReason : waitingFor, guardrailReason != "" ? C_WARN : waitingFor == "Ready" ? C_BULL : C_WARN), f_cell(2, row, "LOCATION", C_MUTED, C_PANEL, text.align_left, "Nearest clustered support/resistance or confirmed selected higher-timeframe channel edge."), f_cell(3, row, nearSupport ? "SUPPORT" : nearResistance ? "RESISTANCE" : nearChannelSupport ? decisionChannelName + " CH SUP" : nearChannelResistance ? decisionChannelName + " CH RES" : "NONE", C_TEXT), row += 1
        if displayMode != "Minimal"
            f_cell(0, row, activeState ? "LIVE CHECK" : "READINESS", C_INFO, C_PANEL, text.align_left, "C = Context, L = Location, T = Trigger, E = Economics, S = Safety. A check mark means that independent gate is currently passing; ! means a guardrail is blocking new plans."), f_cell(1, row, readinessText, readinessCount == 5 ? C_BULL : C_WARN), f_cell(2, row, "GATES", C_MUTED, C_PANEL, text.align_left, "Five independent gates must pass for Quality A or B. A live active plan keeps its captured quality while this row shows current conditions."), f_cell(3, row, str.tostring(readinessCount) + "/5", readinessCount == 5 ? C_BULL : C_WARN), row += 1
        f_cell(0, row, "MTF", C_MUTED, C_PANEL, text.align_left, "Confirmed multi-timeframe trend states. ▲ bullish, ▼ bearish, ◆ range/conflicted, … unavailable because the selected timeframe is lower than the chart. HTF values use closed bars."), f_cell(1, row, f_tf_name(tf1) + " " + f_tf_mark(mtf1), f_tf_color(mtf1)), f_cell(2, row, f_tf_name(tf2) + " " + f_tf_mark(mtf2) + "  " + f_tf_name(tf3) + " " + f_tf_mark(mtf3), f_dir_color(mtfSum)), f_cell(3, row, f_tf_name(tf4) + " " + f_tf_mark(mtf4), f_tf_color(mtf4)), row += 1
        if activeState
            f_cell(0, row, "ENTRY", C_MUTED, C_PANEL, text.align_left, "Reference entry captured when the candidate was confirmed."), f_cell(1, row, f_fmt(entry), C_INFO), f_cell(2, row, "STOP", C_MUTED, C_PANEL, text.align_left, "Structural invalidation price. The stop is never widened after activation."), f_cell(3, row, f_fmt(stop), C_BEAR), row += 1
            f_cell(0, row, "TP1", C_MUTED, C_PANEL, text.align_left, "First planned profit objective at 1.5 times the initial stop distance."), f_cell(1, row, f_fmt(tp1), C_BULL), f_cell(2, row, "TP2", C_MUTED, C_PANEL, text.align_left, "Second planned profit objective at 2.5 times the initial stop distance."), f_cell(3, row, f_fmt(tp2), C_BULL), row += 1
            f_cell(0, row, "TP3", C_MUTED, C_PANEL, text.align_left, "Final planned profit objective at 3.5 times the initial stop distance."), f_cell(1, row, f_fmt(tp3), C_BULL), f_cell(2, row, "NET R:R", C_MUTED, C_PANEL, text.align_left, "Estimated reward-to-risk after configured fees, spread, and slippage."), f_cell(3, row, na(netRR) ? "—" : "1:" + str.tostring(netRR, "#.##"), weakEconomics ? C_WARN : C_BULL), row += 1
            if not beginnerMode or displayMode == "Full"
                f_cell(0, row, isForex ? "Lots approx." : "Units", C_MUTED), f_cell(1, row, str.tostring(isForex ? forexLots : units, "#.####"), C_TEXT), f_cell(2, row, "Margin est.", C_MUTED), f_cell(3, row, str.tostring(estimatedMargin, "#.##") + " " + accountCurrency, C_TEXT), row += 1
            f_cell(0, row, "INVALIDATION", C_WARN, C_PANEL, text.align_left, "Price condition that makes the setup thesis invalid."), f_cell(1, row, signalDirection > 0 ? "Below stop" : "Above stop", C_WARN), f_cell(2, row, "RISK", C_MUTED, C_PANEL, text.align_left, "Planned account risk from your Risk Management settings."), f_cell(3, row, str.tostring(riskCapital, "#.##") + " " + accountCurrency, C_TEXT), row += 1
            string managementAction = not tp1Hit ? "At TP1: close " + str.tostring(tp1ClosePct) + "%" : not tp2Hit ? (breakEvenApplied ? "Stop at break-even" : "TP1 done · keep stop") : trailAfterTp2 ? "Trail remaining position" : "Runner active"
            f_cell(0, row, "NEXT ACTION", C_INFO, C_PANEL, text.align_left, "Suggested manual plan management. It is not an exchange instruction or automated close."), f_cell(1, row, managementAction, C_INFO), f_cell(2, row, "PLAN", C_MUTED), f_cell(3, row, signalState, stateColor), row += 1
            f_cell(0, row, "WHY", C_INFO, C_PANEL, text.align_left, "Up to three independent evidence families supporting the candidate."), f_cell(1, row, setupName, C_TEXT, C_PANEL, text.align_left, "The named trigger that was captured when this plan activated."), f_cell(2, row, abnormalVol ? "Volume confirmed" : f_dir_text(mtfSum), C_TEXT), f_cell(3, row, isForex ? str.tostring(forexStopPips, "#.1") + " pips" : nearSupport or nearResistance ? "At key level" : activeSession, C_TEXT), row += 1
        f_cell(0, row, "RISKS", C_CRYPTO, C_PANEL, text.align_left, "Main reasons to wait, reduce confidence, or reject a setup."), f_cell(1, row, mtfConflict ? "MTF conflict" : excessiveVol ? "High volatility" : volCompression ? "Compression" : "—", mtfConflict or excessiveVol ? C_WARN : C_MUTED), f_cell(2, row, lowVolume ? "Low volume" : highEventRisk ? "Event risk" : volExpansion ? "Expansion" : "—", lowVolume or highEventRisk ? C_WARN : C_MUTED), f_cell(3, row, volumeQuality, C_MUTED), row += 1
        if beginnerMode and compactMode
            string simpleContext = isCrypto and enableCrypto ? cryptoNarrative : isForex and enableForex ? fxNarrative : enableGlobal and balancedContext ? globalNarrative : "Technical context only"
            f_cell(0, row, "CONTEXT", C_CRYPTO, C_PANEL, text.align_left, "Broader market context. It has a small score weight and is never a certain prediction."), f_cell(1, row, simpleContext, C_TEXT), f_cell(2, row, "Decision support only", C_MUTED), f_cell(3, row, "Risk control required", C_WARN), row += 1
        if isCrypto and enableCrypto and not (beginnerMode and compactMode)
            f_cell(0, row, "CRYPTO CONTEXT", C_CRYPTO, C_PANEL, text.align_left, "Limited-weight context from dominance, market-cap proxies, Bitcoin leadership, and current-symbol correlation. It is not a prediction."), f_cell(1, row, cryptoNarrative, C_TEXT), f_cell(2, row, "BTC corr", C_MUTED, C_PANEL, text.align_left, "Rolling correlation between the chart symbol and Bitcoin."), f_cell(3, row, na(btcCorrelation) ? "—" : str.tostring(btcCorrelation, "#.##"), C_TEXT), row += 1
        if isForex and enableForex and not (beginnerMode and compactMode)
            f_cell(0, row, "FOREX CONTEXT", C_CRYPTO, C_PANEL, text.align_left, "Relative base/quote currency-strength approximation from a limited major-pair basket. It is not centralized order flow."), f_cell(1, row, fxNarrative, C_TEXT), f_cell(2, row, "Strength Δ", C_MUTED, C_PANEL, text.align_left, "Base currency strength minus quote currency strength."), f_cell(3, row, str.tostring(nz(baseStrength) - nz(quoteStrength), "#.##"), C_TEXT), row += 1
        if enableGlobal and (balancedContext or fullMacro) and not (beginnerMode and compactMode)
            f_cell(0, row, "GLOBAL", C_CRYPTO, C_PANEL, text.align_left, "Modest intermarket context from configured USD, volatility, yield, equity, gold, and oil proxies. Relationships can change by regime."), f_cell(1, row, globalNarrative, C_TEXT), f_cell(2, row, "Weight", C_MUTED), f_cell(3, row, str.tostring(globalContextScore, "#.##"), C_TEXT), row += 1
        if not (beginnerMode and compactMode) or eventBlackout
            f_cell(0, row, "EVENT", eventBlackout ? C_WARN : C_MUTED, C_PANEL, text.align_left, "Manual scheduled-event risk slot. Pine cannot fetch CNBC, arbitrary live headlines, or a live calendar."), f_cell(1, row, eventStatus, eventBlackout ? C_WARN : C_MUTED), f_cell(2, row, eventName + (eventForecast != "" ? " F:" + eventForecast + " P:" + eventPrevious : ""), C_TEXT), f_cell(3, row, f_post_event(eventTime) ? eventReaction + " · " + reactionState : "", C_MUTED), row += 1
        if enableEconomic and fullMacro
            f_cell(0, row, "MACRO · SLOW", C_CRYPTO, C_PANEL, text.align_left, "Latest Pine-supported economic values. Slow-moving context only; never an intraday trigger."), f_cell(1, row, econCountry1Eff + " " + econField1 + " " + f_fmt(econ1), C_TEXT), f_cell(2, row, econCountry2Eff + " " + econField2 + " " + f_fmt(econ2), C_TEXT), f_cell(3, row, "Context only", C_MUTED), row += 1
        if isStock and enableStockFinancials and fullMacro
            f_cell(0, row, "STOCK · FQ", C_CRYPTO, C_PANEL, text.align_left, "Latest available quarterly financial context for stock symbols. Displayed but not forced into technical signal scoring."), f_cell(1, row, "Revenue " + f_fmt(stockRevenue), C_TEXT), f_cell(2, row, "Net income " + f_fmt(stockNetIncome), C_TEXT), f_cell(3, row, "Not scored", C_MUTED), row += 1
        if closedPlanHistorySize > 0 and array.size(closedPlanHistory) > 0 and row < 29
            int historyRows = math.min(3, array.size(closedPlanHistory))
            for historyOffset = 0 to historyRows - 1
                int historyIndex = array.size(closedPlanHistory) - 1 - historyOffset
                string historyLabel = historyOffset == 0 ? "LAST PLAN" : "PLAN -" + str.tostring(historyOffset)
                f_cell(0, row, historyLabel, C_MUTED, C_PANEL, text.align_left, "Bounded indicator plan history. It records model state, not broker-confirmed fills."), f_cell(1, row, array.get(closedPlanHistory, historyIndex), C_TEXT), f_cell(2, row, historyOffset == 0 ? "GUARD" : "", C_MUTED), f_cell(3, row, historyOffset == 0 ? str.tostring(candidatesToday) + "/" + str.tostring(maxCandidatesPerDay) + " · S" + str.tostring(consecutiveStops) : "", guardrailReason != "" and historyOffset == 0 ? C_WARN : C_MUTED), row += 1
    if showRadarEff
        f_cell(0, row, "QUANTARA RADAR", C_CRYPTO, C_PANEL, text.align_left, "Configured-symbol scanner only. It is not an unlimited market screener and its headers are not clickable."), f_cell(1, row, radarState, C_MUTED), f_cell(2, row, str.tostring(radarLimit) + " symbols", C_MUTED), f_cell(3, row, radarTf, C_INFO), row += 1
        if radarState == "Collapsed"
            int longs = 0
            int shorts = 0
            for i = 0 to radarLimit - 1
                longs += array.get(radarDirs, i) > 0 ? 1 : 0
                shorts += array.get(radarDirs, i) < 0 ? 1 : 0
            f_cell(0, row, str.tostring(longs) + " LONG", C_BULL), f_cell(1, row, str.tostring(shorts) + " SHORT", C_BEAR), f_cell(2, row, str.tostring(radarLimit - longs - shorts) + " WAIT", C_WARN), f_cell(3, row, "Configured only", C_MUTED), row += 1
        else
            f_cell(0, row, "SYMBOL", C_MUTED, C_SURFACE), f_cell(1, row, "BIAS", C_MUTED, C_SURFACE), f_cell(2, row, "SCORE", C_MUTED, C_SURFACE), f_cell(3, row, "WARN", C_MUTED, C_SURFACE), row += 1
            int requestedRows = radarState == "Expanded" ? radarLimit : math.min(6, radarLimit)
            int rowsToShow = math.min(requestedRows, 30 - row)
            for i = 0 to rowsToShow - 1
                int radarIndex = array.get(radarOrder, i)
                float rs = array.get(radarScores, radarIndex)
                int rd = array.get(radarDirs, radarIndex)
                float rv = array.get(radarVols, radarIndex)
                string symbolText = array.get(radarSymbols, radarIndex)
                string shortSymbol = str.contains(symbolText, ":") ? array.get(str.split(symbolText, ":"), 1) : symbolText
                bool changed = array.get(radarChanged, radarIndex)
                string radarAction = na(rs) ? "DATA" : eventBlackout ? "BLOCKED" : rs >= minScoreEff and rd != 0 ? "READY" : changed ? "NEW" : not na(rv) and rv < 0.65 ? "LOW VOL" : "WATCH"
                f_cell(0, row, shortSymbol, C_TEXT), f_cell(1, row, f_tf_mark(rd) + (rd > 0 ? " LONG" : rd < 0 ? " SHORT" : " WAIT"), f_dir_color(rd)), f_cell(2, row, na(rs) ? "—" : str.tostring(math.round(rs)), C_TEXT), f_cell(3, row, radarAction, radarAction == "READY" ? C_BULL : radarAction == "WATCH" ? C_MUTED : C_WARN), row += 1
    if debug and row < 29
        int contextReq = resourceProfile == "Chart Focus" ? 0 : isForex ? 6 : isCrypto ? (fullMacro ? 8 : 4) : 0
        int globalReq = balancedContext ? 3 : fullMacro ? 8 : 0
        int econReq = enableEconomic and fullMacro ? 2 : 0
        int stockReq = isStock and enableStockFinancials and fullMacro ? 2 : 0
        int radarReq = showRadarEff ? radarLimit : 0
        int estimatedReq = 5 + contextReq + globalReq + econReq + stockReq + radarReq
        f_cell(0, row, "DEBUG", C_CRYPTO), f_cell(1, row, "Requests " + str.tostring(estimatedReq) + "/40", estimatedReq <= 36 ? C_BULL : C_WARN), f_cell(2, row, marketType + " · " + styleEff, C_TEXT), f_cell(3, row, resourceProfile, C_MUTED)

string readableAlert = "Quantara Vision | " + syminfo.tickerid + " | " + timeframe.period + " | " + signalState + " | " + (signalDirection > 0 ? "LONG" : signalDirection < 0 ? "SHORT" : "NONE") + " | score=" + str.tostring(activeState ? activeScore : rawScore, "#.0")
string jsonAlert = "{\"product\":\"Quantara Vision\",\"version\":\"0.6.0\",\"symbol\":\"" + syminfo.tickerid + "\",\"timeframe\":\"" + timeframe.period + "\",\"market_type\":\"" + marketType + "\",\"state\":\"" + signalState + "\",\"direction\":\"" + (signalDirection > 0 ? "long" : signalDirection < 0 ? "short" : "none") + "\",\"score\":" + f_json_num(activeState ? activeScore : rawScore) + ",\"setup\":\"" + setupName + "\",\"entry\":" + f_json_num(entry) + ",\"stop\":" + f_json_num(stop) + ",\"tp1\":" + f_json_num(tp1) + ",\"tp2\":" + f_json_num(tp2) + ",\"tp3\":" + f_json_num(tp3) + ",\"rr\":" + f_json_num(netRR) + ",\"event_risk\":" + (eventBlackout ? "true" : "false") + ",\"timestamp\":" + str.tostring(time_close) + "}"
bool runtimeCandidateAlerts = alertWorkflow == "Candidate Only" or alertWorkflow == "All"
bool runtimeManagementAlerts = alertWorkflow == "Plan Management" or alertWorkflow == "All"
bool runtimeRiskAlerts = alertWorkflow == "Risk Only" or alertWorkflow == "All"
if alertsEnabled and runtimeCandidateAlerts and newCandidate and alertCandidates
    alert(jsonAlerts ? jsonAlert : readableAlert, confirmClose ? alert.freq_once_per_bar_close : alert.freq_once_per_bar)
if alertsEnabled and runtimeRiskAlerts and invalidatedNow and not ambiguousBar
    alert(jsonAlerts ? jsonAlert : readableAlert + " | INVALIDATED", alert.freq_once_per_bar)
if alertsEnabled and runtimeRiskAlerts and ambiguousBar
    alert(jsonAlerts ? jsonAlert : readableAlert + " | AMBIGUOUS BAR — REVIEW OHLC ORDER MANUALLY", alert.freq_once_per_bar)
if alertsEnabled and runtimeManagementAlerts and target1Now
    alert(readableAlert + " | TP1 HIT | SUGGEST CLOSE " + str.tostring(tp1ClosePct) + "%" + (afterTp1Action == "Move Stop To Break-even" ? " | MOVE STOP TO BE" : ""), alert.freq_once_per_bar)
if alertsEnabled and runtimeManagementAlerts and target2Now
    alert(readableAlert + " | TP2 HIT | SUGGEST CLOSE " + str.tostring(tp2ClosePct) + "%" + (trailAfterTp2 ? " | TRAIL RUNNER" : ""), alert.freq_once_per_bar)
if alertsEnabled and runtimeManagementAlerts and target3Now
    alert(readableAlert + " | CLOSED TP3", alert.freq_once_per_bar)
if alertsEnabled and runtimeRiskAlerts and planEndedNow and (signalState == "Closed Stop" or signalState == "Ambiguous Bar" or signalState == "Expired Event")
    alert(jsonAlerts ? jsonAlert : readableAlert + " | PLAN CLOSED", alert.freq_once_per_bar)
if alertsEnabled and runtimeCandidateAlerts and alertStructure and barstate.isconfirmed and (bosUp or bosDown)
    alert(readableAlert + " | STRUCTURE BREAK", alert.freq_once_per_bar_close)
if alertsEnabled and runtimeCandidateAlerts and alertStructure and barstate.isconfirmed and (retestUp or retestDown)
    alert(readableAlert + " | RETEST", alert.freq_once_per_bar_close)
if alertsEnabled and runtimeRiskAlerts and alertEvents and eventBlackout and not eventBlackout[1]
    alert(readableAlert + " | " + eventStatus, alert.freq_once_per_bar)

alertcondition(newCandidate and signalDirection > 0, "Long Candidate", "Quantara Vision long candidate")
alertcondition(newCandidate and signalDirection < 0, "Short Candidate", "Quantara Vision short candidate")
alertcondition(newCandidate and signalDirection > 0 and barstate.isconfirmed, "Confirmed Long", "Quantara Vision confirmed long")
alertcondition(newCandidate and signalDirection < 0 and barstate.isconfirmed, "Confirmed Short", "Quantara Vision confirmed short")
alertcondition(invalidatedNow and not ambiguousBar, "Invalidation / Stop", "Quantara Vision plan invalidated")
alertcondition(target3Now, "TP3", "Quantara Vision TP3 reached")
alertcondition(target1Now, "TP1 Management", "Quantara Vision TP1 reached: apply configured manual management action")
alertcondition(target2Now, "TP2 Management", "Quantara Vision TP2 reached: manage remaining position")
alertcondition(ambiguousBar, "Ambiguous Bar", "Quantara Vision cannot determine target/stop order inside this OHLC bar")
alertcondition(planEndedNow, "Plan Closed", "Quantara Vision plan closed, expired, or had ambiguous OHLC order")
alertcondition(bosUp or bosDown, "Structure Break", "Quantara Vision confirmed structure break")
alertcondition(retestUp or retestDown, "Retest", "Quantara Vision retest")
alertcondition(eventBlackout, "Event Blackout", "Quantara Vision manual high-impact event blackout")
